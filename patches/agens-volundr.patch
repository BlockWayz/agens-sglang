+        # get_cuda_graph_max_batch_size + 1 — the largest bs that will ever be captured. Each
+        # request contributes at most `window` keys, which is what makes this buffer small
+        # (32 * 4096 int32 = 512 kB) where the backend's is bs * max_context_len.
+        self.max_bs = int(fa.kv_indptr[0].shape[0]) - 1

diff --git a/python/sglang/srt/configs/volundr_cfg.py b/python/sglang/srt/configs/volundr_cfg.py
new file mode 100644
index 0000000..7074a19
--- /dev/null
+++ b/python/sglang/srt/configs/volundr_cfg.py
@@ -0,0 +1,140 @@
+"""Config classes that let sglang serve Volundr through its KDA linear-attention backend.
+
+Subclassing Qwen3_5TextConfig keeps the Qwen3.5 plumbing (the projection dims, rope parameters and
+the SWA/hybrid bookkeeping) while adding the two things Volundr does differently:
+
+  * the layer map. Qwen3NextConfig derives `layers_block_type` from `full_attention_interval`, i.e.
+    every 4th layer. Volundr's attention layers sit at 3, 8, 12, 17, 21, 26, 30, 31, 35, 40, 44, 49,
+    53, 58, 62, 63, 67, 71 because block expansion shifted the pattern, so the derived map is wrong
+    at 14 of 18 positions — it would hand KDA layers to the softmax-attention backend. The three
+    properties below take the map from `mixer_types`, which is the checkpoint's own record.
+
+  * the recurrent-state layout. Volundr's linear layers are KDA (per-channel forget gate), not GDN,
+    so they need KimiLinearCacheParams: the KDA backend reads its conv state as [kernel-1, dim],
+    transposed from the GDN/Mamba2 [dim, kernel-1] layout, and slices it by q/k/v sub-block.
+
+VolundrConfig (model_type "volundr") is the full vision+text checkpoint config, so the vision tower
+can be served. It mirrors sglang's Qwen3_5Config with Volundr's text config as the text sub-config.
+The published checkpoint also carries an `auto_map` for its transformers reference implementation;
+sglang always resolves model_type "volundr" to THIS class instead (see
+utils/hf_transformers/config.py), because the reference config lacks sglang's cache/layer-map
+properties.
+"""
+from typing import List
+
+from transformers import PretrainedConfig
+
+from sglang.srt.configs.mamba_utils import (
+    KimiLinearCacheParams,
+    KimiLinearStateShape,
+    mamba2_state_dtype,
+)
+from sglang.srt.configs.qwen3_5 import Qwen3_5TextConfig, Qwen3_5VisionConfig
+from sglang.srt.runtime_context import get_parallel
+
+
+class VolundrTextConfig(Qwen3_5TextConfig):
+    model_type = "volundr_text"
+
+    def __init__(self, mixer_types=None, layer_types=None, bcsa_window=4096,
+                 bcsa_compress=4, bcsa_topk=512, engram_layers=None, mhc_streams=0, **kwargs):
+        # keep our fields off the parent's constructor, then restore them: the parent drops unknowns
+        super().__init__(**kwargs)
+        if mixer_types:
+            self.mixer_types = list(mixer_types)
+            self.layer_types = ["full_attention" if m in ("attn", "bcsa") else "linear_attention"
+                                for m in self.mixer_types]
+        elif layer_types:
+            self.layer_types = list(layer_types)
+            self.mixer_types = ["kda" if t == "linear_attention" else "bcsa" for t in self.layer_types]
+        self.bcsa_window = bcsa_window
+        self.bcsa_compress = bcsa_compress
+        self.bcsa_topk = bcsa_topk
+        self.engram_layers = engram_layers or []
+        self.mhc_streams = mhc_streams
+
+    # ---- layer map: from the tensors, not from full_attention_interval --------------------------
+    @property
+    def layers_block_type(self) -> List[str]:
+        return ["linear_attention" if m == "kda" else "full_attention" for m in self.mixer_types]
+
+    @property
+    def linear_layer_ids(self) -> List[int]:
+        return [i for i, m in enumerate(self.mixer_types) if m == "kda"]
+
+    @property
+    def full_attention_layer_ids(self) -> List[int]:
+        return [i for i, m in enumerate(self.mixer_types) if m != "kda"]
+
+    # ---- recurrent state: KDA layout, not GDN ---------------------------------------------------
+    @property
+    def mamba2_cache_params(self) -> KimiLinearCacheParams:
+        return KimiLinearCacheParams(
+            shape=KimiLinearStateShape.create(
+                tp_world_size=get_parallel().attn_tp_size,
+                num_heads=self.linear_num_value_heads,
+                head_dim=self.linear_value_head_dim,
+                num_k_heads=self.linear_num_key_heads,
+                head_k_dim=self.linear_key_head_dim,
+                conv_kernel_size=self.linear_conv_kernel_dim,
+            ),
+            dtype=mamba2_state_dtype(self),
+            layers=self.linear_layer_ids,
+        )
+
+
+class VolundrConfig(PretrainedConfig):
+    """Full checkpoint: Volundr text tower + vision tower."""
+
+    model_type = "volundr"
+    sub_configs = {"vision_config": Qwen3_5VisionConfig, "text_config": VolundrTextConfig}
+    keys_to_ignore_at_inference = ["past_key_values"]
+
+    def __init__(self, text_config=None, vision_config=None, image_token_id=248056,
+                 video_token_id=248057, vision_start_token_id=248053, vision_end_token_id=248054,
+                 tie_word_embeddings=False, **kwargs):
+        if isinstance(vision_config, dict):
+            self.vision_config = self.sub_configs["vision_config"](**vision_config)
+        elif vision_config is None:
+            self.vision_config = self.sub_configs["vision_config"]()
+        else:
+            self.vision_config = vision_config
+        if isinstance(text_config, dict):
+            self.text_config = self.sub_configs["text_config"](**text_config)
+        elif text_config is None:
+            self.text_config = self.sub_configs["text_config"]()
+        else:
+            self.text_config = text_config
+        self.image_token_id = image_token_id
+        self.video_token_id = video_token_id
+        self.vision_start_token_id = vision_start_token_id
+        self.vision_end_token_id = vision_end_token_id
+        super().__init__(**kwargs, tie_word_embeddings=tie_word_embeddings)
+
+
+# Route Volundr's linear layers to sglang's KDA backend rather than its GDN one. The default GDN
+# decode kernel takes a per-head scalar gate (one value per (token, head)); KDA's gate is
+# per-channel, which is what makes it KDA. The `hybrid_gdn_config` isinstance chain in
+# configs/hybrid_arch.py would otherwise claim this config for GDN because it subclasses
+# Qwen3NextConfig; configs/hybrid_arch.py lets an explicit registration here win over that chain.
+def _register_volundr_linear_attn() -> None:
+    from sglang.srt.configs.linear_attn_model_registry import (
+        _LINEAR_ATTN_MODEL_REGISTRY,
+        LinearAttnModelSpec,
+    )
+
+    if any(getattr(s, "config_class", None) is VolundrTextConfig for s in _LINEAR_ATTN_MODEL_REGISTRY):
+        return
+    _LINEAR_ATTN_MODEL_REGISTRY.insert(0, LinearAttnModelSpec(
+        config_class=VolundrTextConfig,
+        backend_class_name="sglang.srt.layers.attention.linear.kda_backend.KDAAttnBackend",
+        arch_names=["VolundrForCausalLM", "VolundrForConditionalGeneration"],
+        uses_mamba_radix_cache=True,
+        support_mamba_cache=True,
+        # the full checkpoint's hf_config is VolundrConfig; match on its text sub-config
+        # (get_text_config() is the identity on a text-only VolundrTextConfig)
+        unwrap_text_config=True,
+    ))
+
+
+_register_volundr_linear_attn()

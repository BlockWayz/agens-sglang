+        core = self.attn(forward_batch, mixed_qkv=mixed_qkv, a=gate, b=beta)
+        z, _ = self.in_proj_z(hidden_states)
+        o = self.norm(core.reshape(-1, self.head_v_dim), z.reshape(-1, self.head_v_dim))

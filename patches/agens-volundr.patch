+                                           quant_config=quant_config, prefix=add_prefix("q_proj", prefix))
+            self.k_proj = ReplicatedLinear(c.hidden_size, self.total_kv_heads * self.head_dim, bias=False,
+                                           quant_config=quant_config, prefix=add_prefix("k_proj", prefix))
+            self.v_proj = ReplicatedLinear(c.hidden_size, self.total_kv_heads * self.head_dim, bias=False,
+                                           quant_config=quant_config, prefix=add_prefix("v_proj", prefix))
+            self.o_proj = ReplicatedLinear(self.total_heads * self.head_dim, c.hidden_size, bias=False,
+                                           quant_config=quant_config, prefix=add_prefix("o_proj", prefix))
+        else:

+"""Blockway Agens reasoning detector for SGLang (`--reasoning-parser agens`).
+Assistant turn: <|think|>reasoning<|/think|>content[<|call|>…<|/call|>]. The generation prompt already opens <|think|>
+(or emits <|think|><|/think|> when enable_thinking=false), so the model output starts inside the think block.
+"""
+from sglang.srt.parser.reasoning_parser import BaseReasoningFormatDetector
+
+
+class AgensReasoningDetector(BaseReasoningFormatDetector):
+    def __init__(self, stream_reasoning: bool = True, force_reasoning: bool = False,
+                 continue_final_message: bool = False, previous_content: str = "", force_nonempty_content: bool = False):
+        super().__init__(
+            "<|think|>", "<|/think|>",
+            think_excluded_tokens=["<|call|>", "<|/call|>", "<|agens_end|>", "<|endoftext|>"],
+            force_reasoning=force_reasoning, stream_reasoning=stream_reasoning,
+            tool_start_token="<|call|>",            # an unclosed think followed by a call = implicit close
+            continue_final_message=continue_final_message, previous_content=previous_content,
+            thinks_internally=True, reasoning_default="enable_thinking", force_nonempty_content=force_nonempty_content,
+        )

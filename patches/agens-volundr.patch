@@ -0,0 +1,1869 @@
+"""Agens Volundr for SGLang.
+
+Volundr is a 72-layer hybrid language model with an optional vision tower:
+
+  * 54 KDA layers (Kimi Delta Attention: linear attention with a per-channel forget gate), served by
+    sglang's KDA linear-attention backend (KDAAttnBackend) through RadixLinearAttention. Volundr keeps
+    q/k/v, beta and the low-rank gate in separate projections; the calling convention follows
+    models/kimi_linear.py, the reference user of that backend.
+  * 17 BCSA layers (Blockway Compressed-Sparse Attention, VolundrAttention below): a 4,096-token
+    sliding window over the paged KV cache plus a mean-pooled 4:1 far field selected by a learned
+    indexer, merged into one softmax through the window's log-sum-exp. Layer 71 is plain dense
+    attention (`attn` in mixer_types) at any length.
+  * mHC (manifold hyper-connections, VolundrMHC): four residual streams, mixed around every layer.
+  * Engram (VolundrEngram, layers 2 and 22): hashed n-gram conditional memory. The n-gram hash needs
+    the 1-2 token ids before each token, which a ForwardBatch does not carry at decode time; a
+    per-request previous-token cache keyed by the mamba state slot supplies them (see
+    VolundrModel.engram_prev for why that key is the CUDA-graph-safe one).
+  * The BCSA indexer key is a function of the layer input, not of K or V, so each BCSA layer keeps a
+    128-wide per-token side cache of it, indexed by the same out_cache_loc as the KV write.
+  * Vision: VolundrForConditionalGeneration serves the vision tower (sglang's qwen3_vl vision model)
+    with `--enable-multimodal`. Image tokens carry 3-D MRoPE positions through the BCSA layers' rotary
+    embedding; everything that indexes the KV cache or the n-gram cache keeps the plain 1-D token
+    index. VolundrForCausalLM is the text-only class.
+
+Serving constraints, checked at startup:
+  * --disable-radix-cache: a radix prefix hit would resume a sequence whose Engram previous-token ids
+    were never seeded.
+  * --disable-prefill-cuda-graph: the Engram extend path reads per-batch metadata that is not stable
+    across prefill-graph replays, and BCSA has no prefill-graph plan. Decode CUDA graphs stay on.
+  * --page-size 1: BCSA reads pooled far-field K/V straight out of the token-indexed KV cache.
+  * --attention-backend fa3 (sm90) or flashinfer (sm89; also required for speculative decoding).
+
+Speculative decoding (TARGET_VERIFY) is served as a CHAIN of draft tokens per request (sglang's NGRAM
+with --speculative-ngram-max-bfs-breadth 1, or a top-k-1 drafter such as DFlash):
+  - KDA: sglang's KDAAttnBackend runs the verify kernel against the committed state while
+    checkpointing every draft step's conv window and recurrent state in the mamba pool's speculative
+    scratch; commit_mamba_states_after_verify then scatters the accepted step back.
+  - BCSA: the KV write and the indexer-key write are per slot, so they need nothing: sglang assigns
+    the D draft slots before the forward and frees the rejected tail after it. The local branch gets
+    its own flashinfer verify plan (_BcsaFlashInfer._plan_verify: D queries per request over the last
+    W + D - 1 keys, causal + window_left, graph-mode buffers per captured batch size). The far branch
+    is the decode far branch with one position per token (_far_sparse): every draft query's far set
+    lies in the committed prefix because D <= W. Block keys of blocks completed inside the draft
+    window are pooled and written at the draft slot of the block's last position; rows that are
+    CUDA-graph padding are masked through the linear backend's mamba slot == -1.
+  - Engram: rows are hashed from in-batch shifts plus the committed prev pair, and the verify forward
+    writes nothing to engram_prev. It records, for every possible accept length j+1, the prev pair
+    that acceptance would leave behind (engram_cand); commit_after_verify, called from
+    HybridLinearAttnBackend.update_mamba_state_after_mtp_verify, scatters the chosen pair into
+    engram_prev. All of it is static-shape and host-sync-free, so the verify step is graph-captured.
+  - Why chain-only: tree verify copies the accepted nodes' K/V into the first accept_len draft slots,
+    which the per-slot indexer and block-key caches would not follow, and a tree node's position is
+    not seq_len + j. The constructor refuses topk > 1.
+
+Layer typing comes from `config.mixer_types` (54 KDA + 17 BCSA + 1 dense), with `layer_types` as a
+fallback.
+
+Every RMSNorm of the attention/MLP stack (input/post_attention/final/q_norm/k_norm) is GemmaRMSNorm,
+the zero-centred `xhat * (1 + weight)` form — see the note on q_norm below. mHC's own norm and the KDA
+output norm are the plain `weight *` form. Getting this wrong is silent and total.
+"""
+import os
+from typing import Iterable, Optional
+
+import torch
+from torch import nn
+
+from sglang.kernels.ops.attention.flash_attention import flash_attn_with_kvcache
+from sglang.kernels.ops.attention.fla.fused_norm_gate import FusedRMSNormGated
+from sglang.kernels.ops.attention.utils import create_flashinfer_kv_indices_triton
+from sglang.srt.layers.activation import SiluAndMul
+from sglang.srt.layers.layernorm import GemmaRMSNorm, RMSNorm
+from sglang.srt.layers.linear import (
+    ColumnParallelLinear,
+    MergedColumnParallelLinear,
+    ReplicatedLinear,
+    RowParallelLinear,
+)
+from sglang.srt.layers.logits_processor import LogitsProcessor
+from sglang.srt.layers.quantization.base_config import QuantizationConfig
+from sglang.srt.layers.radix_attention import RadixAttention
+from sglang.srt.layers.radix_linear_attention import RadixLinearAttention
+from sglang.srt.layers.rotary_embedding import get_rope
+from sglang.srt.layers.vocab_parallel_embedding import (
+    ParallelLMHead,
+    VocabParallelEmbedding,
+)
+from sglang.srt.model_executor.forward_batch_info import ForwardBatch
+from sglang.srt.model_executor.forward_context import get_attn_backend
+from sglang.srt.model_executor.runner import get_is_capture_mode as _is_capture_mode
+from sglang.srt.model_loader.weight_utils import (
+    default_weight_loader,
+    sharded_weight_loader,
+)
+from sglang.srt.runtime_context import get_parallel
+from sglang.srt.utils import add_prefix, set_weight_attrs
+from sglang.srt.utils.hf_transformers_utils import get_rope_config
+from sglang.srt.distributed.parallel_state import get_pp_group
+from sglang.srt.managers.mm_utils import (
+    MultiModalityDataPaddingPatternMultimodalTokens,
+    general_mm_embed_routine,
+)
+from sglang.srt.managers.schedule_batch import Modality, MultimodalDataItem, MultimodalInputs
+from sglang.srt.runtime_context import get_server_args
+
+
+# Token ids at or above the tokenizer's length (248,077 for the published checkpoints) are padding rows
+# of the embedding and lm_head. They can still receive probability mass (notably a retired tool-call
+# id, which competes with <|call|> when sampling), and a sampled one cannot be detokenized, so their
+# logits are masked. VOLUNDR_MASK_UNUSED_TOKENS=0 turns this off.
+_UNUSED_TOKEN_START = int(os.environ.get("VOLUNDR_UNUSED_TOKEN_START", "248077"))
+_MASK_UNUSED_TOKENS = os.environ.get("VOLUNDR_MASK_UNUSED_TOKENS", "1").strip() != "0"
+
+
+def _mask_unused_tokens(out):
+    """Set the logits of token ids the tokenizer does not define to -inf (in place)."""
+    if not _MASK_UNUSED_TOKENS:
+        return out
+    logits = getattr(out, "next_token_logits", None)
+    if logits is not None and logits.shape[-1] > _UNUSED_TOKEN_START:
+        logits[..., _UNUSED_TOKEN_START:] = float("-inf")
+    return out
+
+
+def _text_cfg(config):
+    """The checkpoint nests the language model under text_config."""
+    return getattr(config, "text_config", config)
+
+
+def _full_attn_backend():
+    """The softmax-attention half of the hybrid backend (the other half drives the KDA layers)."""
+    b = get_attn_backend()
+    return getattr(b, "full_attn_backend", None) or b
+
+
+def _is_flashinfer(backend) -> bool:
+    """Is this sglang's FlashInfer backend (rather than the FlashAttention one)?
+
+    The BCSA local branch has two implementations and this picks between them, keyed on the backend
+    object rather than on a flag: `--attention-backend fa3` (sm90) runs the FlashAttention branch and
+    `--attention-backend flashinfer` (required on sm89) runs the FlashInfer one.
+    """
+    return type(backend).__name__.startswith("FlashInfer")
+
+
+def _attn_tp():
+    """(rank, world) of the attention tensor-parallel group.
+
+    attn_tp, not the global tp: it is the group `sharded_weight_loader` slices against and the one
+    VolundrTextConfig.mamba2_cache_params already sizes the KDA recurrent state with. With DP
+    attention off — which is the only configuration this class is served in — the two coincide.
+    """
+    p = get_parallel()
+    return p.attn_tp_rank, p.attn_tp_size
+
+
+def _spec_draft_tokens() -> int:
+    """Draft tokens per request under speculative decoding, 0 when it is off.
+
+    Read from the server args rather than from a ForwardBatch because the graph-mode verify
+    buffers and the Engram candidate table are sized at construction. sglang fixes the value
+    before the model is built (NGRAM defaults it to 12; DFlash sets it to its block size).
+    """
+    try:
+        sa = get_server_args()
+    except Exception:
+        return 0
+    if sa is None or not getattr(sa, "speculative_algorithm", None):
+        return 0
+    return int(getattr(sa, "speculative_num_draft_tokens", None) or 0)
+
+
+def _live_rows(forward_batch: ForwardBatch, bs: int) -> Optional[torch.Tensor]:
+    """[bs] bool, False for the rows a CUDA graph padded the batch with, or None when the
+    linear backend's metadata is not there. The signal is the mamba slot the hybrid backend
+    refreshes in place before every replay (-1 on padded rows); the batch's own positions and
+    req_pool_indices pad to 0, which is a live request."""
+    lin = getattr(get_attn_backend(), "linear_attn_backend", None)
+    idx = getattr(getattr(lin, "forward_metadata", None), "mamba_cache_indices", None)
+    if idx is None or idx.shape[0] < bs:
+        return None
+    return idx[:bs] >= 0
+
+
+def _set_loader(param, fn) -> None:
+    """Replace a parameter's weight_loader, whatever kind of parameter it is.
+
+    sglang's parallel Linear classes give their weight a ModelWeightParameter whose `weight_loader`
+    is a read-only property over `_weight_loader`; a plain nn.Parameter just carries the attribute.
+    set_weight_attrs refuses to overwrite either (it asserts), so neither can be used directly.
+    """
+    if hasattr(param, "_weight_loader"):
+        param._weight_loader = fn
+    else:
+        if hasattr(param, "weight_loader"):
+            delattr(param, "weight_loader")
+        set_weight_attrs(param, {"weight_loader": fn})
+
+
+def _blockwise_column_loader(block_sizes, tp_rank: int, tp_size: int, dim: int = 0):
+    """Loader for a fused projection whose output dim is a concatenation of independent blocks.
+
+    Volundr ships `in_proj_qkv` (and the conv1d beside it) as ONE tensor laid out [q | k | v], with
+    q and k 16 heads wide and v 48. A plain column-parallel load takes a single contiguous slice of
+    that, which on two ranks hands rank 0 all of q plus half of k — silently, and the KDA kernel
+    accepts the shape. This takes each block's own per-rank slice and concatenates them, which is
+    what sglang's mamba_v2_sharded_weight_loader does for the same reason.
+    """
+
+    def loader(param: torch.Tensor, loaded_weight: torch.Tensor) -> None:
+        parts, off = [], 0
+        for full in block_sizes:
+            shard = full // tp_size
+            parts.append(loaded_weight.narrow(dim, off + tp_rank * shard, shard))
+            off += full
+        assert off == loaded_weight.shape[dim], (
+            f"block sizes {block_sizes} do not tile the loaded dim {loaded_weight.shape[dim]}")
+        param.data.copy_(torch.cat(parts, dim=dim))
+
+    return loader
+
+
+def _mixer_kind(c, layer_id: int) -> str:
+    """'kda' | 'bcsa' | 'attn' for a layer.
+
+    Prefers `mixer_types`, which is the checkpoint's own record, and falls back to `layer_types`.
+    """
+    mt = getattr(c, "mixer_types", None)
+    if mt:
+        return mt[layer_id]
+    lt = getattr(c, "layer_types", None)
+    if lt:
+        return "kda" if lt[layer_id] == "linear_attention" else "bcsa"
+    raise ValueError("config carries neither mixer_types nor layer_types; cannot type the layers")
+
+
+class VolundrMLP(nn.Module):
+    def __init__(self, hidden_size, intermediate_size, quant_config=None, prefix=""):
+        super().__init__()
+        self.gate_up_proj = MergedColumnParallelLinear(
+            hidden_size, [intermediate_size] * 2, bias=False,
+            quant_config=quant_config, prefix=add_prefix("gate_up_proj", prefix))
+        self.down_proj = RowParallelLinear(
+            intermediate_size, hidden_size, bias=False,
+            quant_config=quant_config, prefix=add_prefix("down_proj", prefix))
+        self.act_fn = SiluAndMul()
+
+    def forward(self, x):
+        gate_up, _ = self.gate_up_proj(x)
+        return self.down_proj(self.act_fn(gate_up))[0]
+
+
+class VolundrKDA(nn.Module):
+    """Kimi Delta Attention. Volundr keeps the projections separate; sglang's KDA backend takes
+    (mixed_qkv, a, b) and owns the conv state and the recurrent state.
+
+    Tensor parallelism. Every head-indexed quantity is split across attn_tp ranks and everything the
+    KDA backend sees is already per-rank — the backend and its kernels read no tp_size anywhere, so
+    the division has to happen here and must not be repeated downstream (models/qwen3_next.py and
+    models/kimi_linear.py are the references, and this follows qwen3_next's discipline of sharding
+    everything on attn_tp because that is the group `sharded_weight_loader` hard-codes, and the
+    group VolundrTextConfig.mamba2_cache_params already sizes the recurrent state with):
+
+      in_proj_qkv  column-parallel, but BLOCKWISE — [q | k | v] are three independent head groups
+      in_proj_b    column-parallel over the 48 value heads (one scalar each)
+      in_proj_z    column-parallel over value channels
+      f_down       replicated (rank-128 bottleneck; every rank computes the same 128 numbers)
+      f_up         column-parallel over value heads, i.e. THE SAME head split as in_proj_qkv's v
+                   block and as dt_bias — the per-channel gate must line up with the channels it
+                   gates, which is the one thing that fails silently if it is got wrong
+      conv1d       blockwise column-parallel like in_proj_qkv (it is the same [q|k|v] layout)
+      A_log        per value head, sliced on load
+      dt_bias      per (value head, key channel), head-major, so a contiguous dim-0 slice is a
+                   contiguous head range — sliced on load
+      norm         replicated (it is per head_v_dim, not per head)
+      out_proj     row-parallel, and it owns the all-reduce (reduce_results defaults to True; this
+                   class threads the residual itself and has no LayerCommunicator)
+
+    At tp_size == 1 every projection stays a ReplicatedLinear, so packed INT4 weights load without
+    being re-split by the merged and column-parallel loaders; that is also why tp_size > 1 is a
+    bf16-only configuration here.
+    """
+
+    def __init__(self, config, layer_id: int, quant_config=None, prefix: str = ""):
+        super().__init__()
+        c = _text_cfg(config)
+        tp_rank, tp_size = _attn_tp()
+        self.tp_size = tp_size
+        total_k_heads = c.linear_num_key_heads             # 16
+        total_v_heads = c.linear_num_value_heads           # 48 — grouped value attention, 3 v per k
+        self.head_k_dim = c.linear_key_head_dim
+        self.head_v_dim = c.linear_value_head_dim
+        if tp_size > 1:
+            for name, n in (("linear_num_key_heads", total_k_heads),
+                            ("linear_num_value_heads", total_v_heads)):
+                if n % tp_size:
+                    raise ValueError(f"KDA {name}={n} is not divisible by attn_tp_size={tp_size}")
+            if quant_config is not None:
+                raise NotImplementedError(
+                    "Volundr tp_size > 1 is bf16 only: the KDA projections become blockwise "
+                    "column-parallel at tp > 1 and this class does not re-split packed quantized "
+                    "weights. Serve INT4 at tp 1 (it fits one 48 GB GPU) or bf16 at tp 2.")
+        # per-rank counts and widths from here down; `total_*` only ever reaches a constructor arg
+        self.num_k_heads = total_k_heads // tp_size
+        self.num_v_heads = total_v_heads // tp_size
+        self.key_dim = self.head_k_dim * self.num_k_heads
+        self.value_dim = self.head_v_dim * self.num_v_heads
+        total_key_dim = self.head_k_dim * total_k_heads
+        total_value_dim = self.head_v_dim * total_v_heads
+        conv_dim = self.key_dim * 2 + self.value_dim
+        qkv_blocks = (total_key_dim, total_key_dim, total_value_dim)
+        gate_rank = getattr(c, "kda_gate_rank", 128)
+
+        if tp_size == 1:
+            self.in_proj_qkv = ReplicatedLinear(
+                c.hidden_size, conv_dim, bias=False, quant_config=quant_config,
+                prefix=add_prefix("in_proj_qkv", prefix))
+            self.in_proj_b = ReplicatedLinear(
+                c.hidden_size, self.num_v_heads, bias=False, quant_config=quant_config,
+                prefix=add_prefix("in_proj_b", prefix))
+            self.in_proj_z = ReplicatedLinear(
+                c.hidden_size, self.value_dim, bias=False, quant_config=quant_config,
+                prefix=add_prefix("in_proj_z", prefix))
+            self.f_up = ReplicatedLinear(gate_rank, self.num_v_heads * self.head_k_dim, bias=False,
+                                         quant_config=quant_config, prefix=add_prefix("f_up", prefix))
+            self.out_proj = ReplicatedLinear(
+                self.value_dim, c.hidden_size, bias=False, quant_config=quant_config,
+                prefix=add_prefix("out_proj", prefix))
+        else:
+            self.in_proj_qkv = ColumnParallelLinear(
+                c.hidden_size, total_key_dim * 2 + total_value_dim, bias=False,
+                quant_config=quant_config, tp_rank=tp_rank, tp_size=tp_size,
+                prefix=add_prefix("in_proj_qkv", prefix))
+            # the default column-parallel loader takes one contiguous slice; [q|k|v] needs three
+            _set_loader(self.in_proj_qkv.weight,
+                        _blockwise_column_loader(qkv_blocks, tp_rank, tp_size))
+            self.in_proj_b = ColumnParallelLinear(
+                c.hidden_size, total_v_heads, bias=False, quant_config=quant_config,
+                tp_rank=tp_rank, tp_size=tp_size, prefix=add_prefix("in_proj_b", prefix))
+            self.in_proj_z = ColumnParallelLinear(
+                c.hidden_size, total_value_dim, bias=False, quant_config=quant_config,
+                tp_rank=tp_rank, tp_size=tp_size, prefix=add_prefix("in_proj_z", prefix))
+            self.f_up = ColumnParallelLinear(
+                gate_rank, total_v_heads * self.head_k_dim, bias=False, quant_config=quant_config,
+                tp_rank=tp_rank, tp_size=tp_size, prefix=add_prefix("f_up", prefix))
+            self.out_proj = RowParallelLinear(
+                total_value_dim, c.hidden_size, bias=False, quant_config=quant_config,
+                input_is_parallel=True, reduce_results=True, tp_rank=tp_rank, tp_size=tp_size,
+                prefix=add_prefix("out_proj", prefix))
+        # low-rank channel-wise gate: this is what makes it KDA rather than GDN. f_down stays
+        # replicated on every rank (128 outputs, no head structure); f_up above splits its output
+        # over the same value heads in_proj_qkv's v block was split over.
+        self.f_down = ReplicatedLinear(c.hidden_size, gate_rank, bias=False,
+                                       quant_config=quant_config, prefix=add_prefix("f_down", prefix))
+
+        # fp32 conv weights and fp32 A_log / dt_bias, matching models/kimi_linear.py. The checkpoint
+        # stores all three in bf16; widening on load is exact and is what both the HF reference and
+        # these kernels do internally anyway (every read is `.to(tl.float32)`).
+        self.conv1d = nn.Conv1d(conv_dim, conv_dim, kernel_size=c.linear_conv_kernel_dim,
+                                groups=conv_dim, padding=c.linear_conv_kernel_dim - 1, bias=False,
+                                dtype=torch.float32)
+        # A_log is per-head (48,); dt_bias is per-channel and flat (48*128,): the channel resolution
+        # that, alongside the low-rank f_down/f_up gate, makes this KDA rather than GDN.
+        self.A_log = nn.Parameter(torch.empty(self.num_v_heads, dtype=torch.float32))
+        self.dt_bias = nn.Parameter(
+            torch.empty(self.num_v_heads * self.head_k_dim, dtype=torch.float32))
+        if tp_size > 1:
+            _set_loader(self.conv1d.weight,
+                        _blockwise_column_loader(qkv_blocks, tp_rank, tp_size))
+            _set_loader(self.A_log, sharded_weight_loader(0))
+            _set_loader(self.dt_bias, sharded_weight_loader(0))
+        # gated RMSNorm, not the fused add-residual form: KDA's output norm takes a gate (z),
+        # whereas sglang's RMSNorm(x, y) means "add y as residual" and returns a tuple. The
+        # activation is the checkpoint's output_gate_type ('swish' == SiLU, the Qwen3.5 default).
+        self.norm = FusedRMSNormGated(self.head_v_dim, eps=c.rms_norm_eps,
+                                      activation=getattr(c, "output_gate_type", None) or "swish")
+
+        self.attn = RadixLinearAttention(
+            layer_id=layer_id,
+            num_q_heads=self.num_k_heads, num_k_heads=self.num_k_heads, num_v_heads=self.num_v_heads,
+            head_q_dim=self.head_k_dim, head_k_dim=self.head_k_dim, head_v_dim=self.head_v_dim,
+            conv_weights=self.conv1d.weight.squeeze(1), bias=None, activation="silu",
+            A_log=self.A_log, dt_bias=self.dt_bias,
+        )
+
+    def forward(self, hidden_states: torch.Tensor, forward_batch: ForwardBatch, **kw):
+        mixed_qkv, _ = self.in_proj_qkv(hidden_states)
+        beta, _ = self.in_proj_b(hidden_states)
+        gate, _ = self.f_up(self.f_down(hidden_states)[0])
+        # Calling convention lifted from models/kimi_linear.py, which drives the same backend:
+        # chunk_kda (the extend kernel) wants the gate shaped [1, T, HV, K] and beta already through
+        # sigmoid, while the decode and target-verify kernels take the raw flat gate [T, HV*K] and
+        # apply both activations themselves. Getting this wrong is silent — the kernels accept
+        # either shape and return garbage.
+        if not forward_batch.forward_mode.is_decode() and not forward_batch.forward_mode.is_target_verify():

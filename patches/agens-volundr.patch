+++ b/python/sglang/srt/sampling/volundr_budget.py
@@ -0,0 +1,143 @@
+"""Per-request reasoning budget for Agens models (Volundr) — an sglang CustomLogitProcessor.
+
+Semantics (per request, `custom_params["reasoning_budget"] = N` tokens):
+  * count generated tokens since the current `<|think|>` opened (the open marker may sit at the end of
+    the prompt when the caller pre-fills it, or be the model's first output token);
+  * once N tokens of thinking have been generated and `<|/think|>` has not appeared, the next token is
+    forced to `<|/think|>` (every other logit -> -inf); generation then continues normally so the model
+    writes its answer;
+  * after a forced close, `<|think|>` is masked for the rest of the request so the model cannot reopen
+    a thinking block;
+  * optional `reasoning_budget_soft_bias = b` (logits): from 80% of the budget on, add b to the
+    `<|/think|>` logit instead of waiting for the hard stop (default 0 = off).
+State lives in the request's own custom_params dict (closed/forced flags are set at force time because
+`req.output_ids` lags one decode step under the overlap scheduler) (sglang injects `__req__` into it in-process),
+so each decode step scans only the tokens generated since the previous step — O(1) per request.
+Requests without `reasoning_budget` never reach this processor (sglang masks per processor).
+Token ids: <|think|> = 248068, <|/think|> = 248069 (override with VOLUNDR_THINK_START_ID /
+VOLUNDR_THINK_END_ID). The OpenAI chat endpoint accepts `reasoning_budget` (and
+`reasoning_budget_soft_bias`) as request fields; VOLUNDR_REASONING_BUDGET sets a server-wide default.
+The server does not need --enable-custom-logit-processor for this processor.
+"""
+from __future__ import annotations
+
+import os
+from typing import Any, Dict, List, Optional
+
+import torch
+
+from sglang.srt.sampling.custom_logit_processor import CustomLogitProcessor
+
+THINK_START = int(os.environ.get("VOLUNDR_THINK_START_ID", "248068"))  # <|think|>
+THINK_END = int(os.environ.get("VOLUNDR_THINK_END_ID", "248069"))      # <|/think|>
+ENV_BUDGET = "VOLUNDR_REASONING_BUDGET"
+ENV_SOFT = "VOLUNDR_REASONING_BUDGET_SOFT_BIAS"
+
+
+class VolundrReasoningBudgetProcessor(CustomLogitProcessor):
+    THINK_START: int = THINK_START
+    THINK_END: int = THINK_END
+
+    def __call__(
+        self,
+        logits: torch.Tensor,
+        custom_param_list: Optional[List[Dict[str, Any]]] = None,
+    ) -> torch.Tensor:
+        if not custom_param_list:
+            return logits
+        neg = float("-inf")
+        for i, p in enumerate(custom_param_list):
+            if not p:
+                continue
+            budget = p.get("reasoning_budget")
+            if not isinstance(budget, int) or isinstance(budget, bool) or budget <= 0:
+                continue
+            req = p.get("__req__")
+            if req is None:
+                continue
+            out = req.output_ids
+            st = p.get("_vb")
+            if st is None:
+                st = p["_vb"] = {"pos": 0, "open": None, "closed": False, "forced": False}
+                # thinking already open in the prompt (the generation prompt ends with `<|think|>`)?
+                tail = list(req.origin_input_ids[-16:])
+                if self.THINK_START in tail:
+                    last_open = len(tail) - 1 - tail[::-1].index(self.THINK_START)
+                    if self.THINK_END not in tail[last_open + 1:]:
+                        st["open"] = 0
+            # incremental scan of tokens generated since the previous step
+            for j in range(st["pos"], len(out)):
+                t = out[j]
+                if t == self.THINK_START:
+                    if st["open"] is None and not st["closed"]:
+                        st["open"] = j + 1
+                elif t == self.THINK_END:
+                    if st["open"] is not None:
+                        st["open"] = None
+                        st["closed"] = True
+            st["pos"] = len(out)
+            if st["closed"]:
+                if st["forced"]:
+                    logits[i, self.THINK_START] = neg  # no reopening after a forced close
+                continue
+            if st["open"] is None:
+                continue
+            n = len(out) - st["open"]
+            if n >= budget:
+                logits[i, :] = neg
+                logits[i, self.THINK_END] = 0.0
+                # Close in our own state now: with the overlap scheduler req.output_ids lags one step,
+                # so waiting to *see* the forced token would force it a second time.
+                st["forced"] = True
+                st["closed"] = True
+                st["open"] = None
+            else:
+                bias = p.get("reasoning_budget_soft_bias") or 0.0
+                if bias and n >= 0.8 * budget:
+                    logits[i, self.THINK_END] += float(bias)
+        return logits
+
+
+_STR: Optional[str] = None
+
+
+def processor_str() -> str:
+    global _STR
+    if _STR is None:
+        _STR = VolundrReasoningBudgetProcessor.to_str()
+    return _STR
+
+
+def _env_int(name: str) -> Optional[int]:
+    v = os.environ.get(name)
+    if not v:
+        return None
+    try:
+        n = int(v)
+    except ValueError:
+        return None
+    return n if n > 0 else None
+
+
+def resolve_budget(request, sampling_params: dict, custom_logit_processor):
+    """Server-side injection for the OpenAI chat endpoint: turn `reasoning_budget` (request field or
+    env default) into custom_params + our processor. Returns (sampling_params, custom_logit_processor)."""
+    budget = getattr(request, "reasoning_budget", None)
+    if budget is None:
+        budget = _env_int(ENV_BUDGET)
+    if not budget or budget <= 0:
+        return sampling_params, custom_logit_processor
+    soft = getattr(request, "reasoning_budget_soft_bias", None)
+    if soft is None:
+        try:
+            soft = float(os.environ.get(ENV_SOFT, "0") or 0)
+        except ValueError:
+            soft = 0.0
+    cp = dict(sampling_params.get("custom_params") or {})
+    cp["reasoning_budget"] = int(budget)
+    cp["reasoning_budget_soft_bias"] = float(soft or 0.0)
+    sampling_params = dict(sampling_params)
+    sampling_params["custom_params"] = cp
+    if custom_logit_processor is None:
+        custom_logit_processor = processor_str()
+    return sampling_params, custom_logit_processor

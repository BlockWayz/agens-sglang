+        # by ~1/14 and the model decodes noise. sglang's own qwen3_5.py uses GemmaRMSNorm here too.
+        self.q_norm = GemmaRMSNorm(self.head_dim, eps=c.rms_norm_eps)
+        self.k_norm = GemmaRMSNorm(self.head_dim, eps=c.rms_norm_eps)
+        if self.bcsa:
+            # The indexer: 4 query heads and 1 key head of 128 dims, both through the SAME norm
+            # (bcsa.py applies self.idx_norm to the query view and to the key), which is a
+            # Qwen3_5RMSNorm, i.e. the zero-centred Gemma form like every other norm here.
+            # Replicated under TP, and not merely because it is small: the block scores are the
+            # MEAN over its 4 query heads, so a head split would change the score rather than
+            # partition it, and the top-512 selection has to be the same set on every rank.
+            self.idx_q = ReplicatedLinear(c.hidden_size, self.idx_heads * self.idx_dim, bias=False,
+                                          quant_config=quant_config, prefix=add_prefix("idx_q", prefix))
+            self.idx_k = ReplicatedLinear(c.hidden_size, self.idx_dim, bias=False,
+                                          quant_config=quant_config, prefix=add_prefix("idx_k", prefix))
+            self.idx_norm = GemmaRMSNorm(self.idx_dim, eps=c.rms_norm_eps)
+
+        # rope_theta lives in `rope_parameters` in this transformers-5 config, so config.rope_theta
+        # is the class default (10000) rather than the checkpoint's 1e7 — get_rope_config reads the
+        # right one. rope_scaling is deliberately NOT passed: it carries mrope_section, which would
+        # build an MRotaryEmbedding expecting [3, N] positions. On a text-only batch the three mrope
+        # axes hold the same position, so interleaved mRoPE is bit-identical to plain RoPE here.
+        rope_theta, _ = get_rope_config(c)
+        rope_frac = getattr(c, "partial_rotary_factor", 0.25)
+        # Sized to the checkpoint's full context. rotary_dim is 0.25 * 256 = 64 (192 dims stay
+        # NoPE), so the table is [max_pos, 64] and get_rope memoises it across all 18 attention
+        # layers.
+        max_pos = int(getattr(c, "max_position_embeddings", 4096))
+        self.rotary_emb = get_rope(
+            self.head_dim, rotary_dim=self.head_dim, max_position=max_pos, base=rope_theta,
+            partial_rotary_factor=rope_frac, is_neox_style=True)
+        # The same table as an MRotaryEmbedding, used ONLY when a batch carries [3, N] image
+        # positions (an extend batch with image inputs). Text batches — and every decode step, where
+        # the three mrope rows coincide — keep the plain rotary above (MRotaryEmbedding's 1-D path
+        # runs the native kernel, a different rounding).
+        rp = dict(getattr(c, "rope_parameters", None) or getattr(c, "rope_scaling", None) or {})
+        self.mrope_section = list(rp.get("mrope_section") or [])
+        self.mrotary_emb = None
+        if self.mrope_section:
+            self.mrotary_emb = get_rope(
+                self.head_dim, rotary_dim=self.head_dim, max_position=max_pos, base=rope_theta,
+                partial_rotary_factor=rope_frac, is_neox_style=True,
+                rope_scaling={"rope_type": "default", "mrope_section": self.mrope_section,
+                              "mrope_interleaved": bool(rp.get("mrope_interleaved", False))})
+        self.attn = RadixAttention(self.num_heads, self.head_dim, self.scaling,
+                                   num_kv_heads=self.num_kv_heads, layer_id=layer_id,
+                                   prefix=add_prefix("attn", prefix))
+
+    def forward(self, positions, hidden_states, forward_batch: ForwardBatch, rope_positions=None, **kw):
+        """`positions` is always the 1-D token index (KV / block / n-gram bookkeeping). `rope_positions`
+        is the [3, N] MRoPE tensor of a multimodal batch, or None."""
+        qg, _ = self.q_proj(hidden_states)
+        gate = None
+        if self.output_gate:
+            qg = qg.view(-1, self.num_heads, 2 * self.head_dim)
+            q, gate = torch.chunk(qg, 2, dim=-1)
+            q = q.reshape(-1, self.num_heads * self.head_dim)
+            gate = gate.reshape(-1, self.num_heads * self.head_dim)
+        else:
+            q = qg
+        k, _ = self.k_proj(hidden_states)
+        v, _ = self.v_proj(hidden_states)
+        q = self.q_norm(q.reshape(-1, self.head_dim)).reshape(-1, self.num_heads * self.head_dim)
+        k = self.k_norm(k.reshape(-1, self.head_dim)).reshape(-1, self.num_kv_heads * self.head_dim)
+        if rope_positions is not None and rope_positions.ndim == 2 and self.mrotary_emb is not None:
+            # An extend batch with images. Only tokens whose three MRoPE rows differ (the image
+            # spans) need the multimodal kernel; every other token — the text of the same request
+            # and any text-only request sharing the batch — goes through the plain rotary kernel on
+            # the t-row, so it stays bit-identical to a text-only batch (the two kernels round
+            # differently). Both kernels rotate in place, hence the clones.
+            mp = rope_positions
+            same = ((mp[0] == mp[1]) & (mp[1] == mp[2]))[:, None]
+            qa, ka = self.rotary_emb(mp[0], q.clone(), k.clone())
+            qb, kb = self.mrotary_emb(mp, q, k)
+            q = torch.where(same, qa, qb)
+            k = torch.where(same, ka, kb)
+        else:
+            q, k = self.rotary_emb(positions, q, k)
+        if self.bcsa and q.shape[0] > 0 and not forward_batch.forward_mode.is_idle():
+            out = self._bcsa_attention(hidden_states, q, k, v, positions, forward_batch)
+        else:
+            out = self.attn(q, k, v, forward_batch)
+        if gate is not None:
+            out = out * torch.sigmoid(gate)
+        return self.o_proj(out)[0]
+
+    # ------------------------------------------------------------------ BCSA
+    def _ensure_state(self, kcache: torch.Tensor, fa):
+        """One-time sizing of the indexer-key side cache and the static block count.
+
+        Both need the memory pools, which only exist after the weights are loaded and the KV budget
+        has been profiled, so they are sized on the first forward. That is safe: the CUDA-graph
+        backend runs two eager warmup forwards before it captures anything (see
+        runner_backend/full_cuda_graph_backend.py capture_one), so the allocation never lands inside
+        a capture — asserted rather than assumed, because an allocation captured into a graph pool
+        would be garbage on replay.
+        """
+        if self.idx_cache is not None:
+            return
+        if torch.cuda.is_current_stream_capturing():
+            raise RuntimeError(
+                "the BCSA indexer-key cache was still unallocated at CUDA-graph capture; it must be "
+                "sized by a warmup forward first")
+        rows = int(kcache.shape[0])
+        # +1 so a clamped/padded index has somewhere harmless to land.
+        self.idx_cache = torch.zeros(rows + 1, self.idx_dim, dtype=kcache.dtype,
+                                     device=kcache.device)
+        self.blk_cache = torch.zeros(rows + 1, self.idx_dim, dtype=kcache.dtype,
+                                     device=kcache.device)
+        # req_to_token is [max_reqs, max_context_len] and lives for the server's lifetime, so both
+        # the handle and the block count are fixed here rather than looked up per forward. The
+        # backend's copy is used, not the metadata's page_table: that one is narrowed to the batch's
+        # own max_seq_len_k on the eager path and only reaches full width inside a graph.
+        self.r2t = fa.req_to_token_pool.req_to_token
+        self.max_blocks = int(self.r2t.shape[1]) // self.compress
+
+    def _flashinfer_helper(self, fa, forward_batch):
+        """The shared local-branch planner, created once and hung off the backend.
+
+        One helper serves all 17 BCSA layers: they all want the same window over the same paged KV
+        cache, so the plan is per FORWARD, not per layer. It is created on the first BCSA forward,
+        which is a warmup forward and therefore eager — asserted, because building a flashinfer
+        wrapper allocates.
+        """
+        h = getattr(fa, "_volundr_bcsa", None)
+        if h is None:
+            if torch.cuda.is_current_stream_capturing():
+                raise RuntimeError(
+                    "the BCSA flashinfer wrappers were still unbuilt at CUDA-graph capture; a "
+                    "warmup forward must run first")
+            h = _BcsaFlashInfer(fa, self.num_heads, self.num_kv_heads, self.head_dim,
+                                self.window, self.scaling)
+            fa._volundr_bcsa = h
+            h.install(fa)
+            # The hooks fire from the backend's metadata prep, which for the forward now in flight
+            # has already run, so plan that one here by hand.
+            #
+            # `capture` is the whole point of this branch. The very first model forward of the
+            # server's life is the eager warmup INSIDE capture_one_shape for the first captured
+            # batch size — decode_cuda_graph_runner calls init_forward_metadata_out_graph, then
+            # run_once() eagerly, then records. The hook did not exist for that first
+            # init_forward_metadata_out_graph, so without this the first captured batch size would
+            # record the EAGER wrapper into its graph and every replay at that size would read a
+            # wrapper nobody re-plans. get_is_capture_mode() is the flag that distinguishes this
+            # warmup from a genuinely eager forward; it is the same signal qwen3_next.py uses.
+            capture = bool(_is_capture_mode())
+            h.plan(forward_batch, graph=capture, in_capture=capture)
+        return h
+
+    def _bcsa_attention(self, hidden_states, q, k, v, positions, forward_batch: ForwardBatch):
+        mode = forward_batch.forward_mode
+        is_verify = mode.is_target_verify()
+        if mode.is_draft_extend_v2():
+            raise NotImplementedError(
+                f"BCSA does not run as a draft model ({mode}); it is the verify target only")
+        fa = _full_attn_backend()
+        use_fi = _is_flashinfer(fa)
+        if is_verify and not use_fi:
+            raise NotImplementedError(
+                "BCSA target-verify (speculative decoding) is implemented on the FlashInfer local "
+                "branch only (--attention-backend flashinfer); the fa3 local branch has no verify "
+                "plan")
+        if getattr(fa, "page_size", 1) != 1:
+            raise RuntimeError(
+                "BCSA needs page_size 1 — it reads pooled far-field K/V straight out of the "
+                "token-indexed KV cache. Launch with --page-size 1")
+        meta = getattr(fa, "forward_metadata", None)
+        if meta is None:
+            raise RuntimeError(
+                "BCSA needs a planned FlashAttention or FlashInfer backend; launch with "
+                "--attention-backend fa3 (sm90) or --attention-backend flashinfer (sm89)")
+        pool = fa.token_to_kv_pool
+        kcache, vcache = pool.get_kv_buffer(self.attn.layer_id)
+        H, KV, D = self.num_heads, self.num_kv_heads, self.head_dim
+        T = q.shape[0]
+        qh = q.view(T, H, D)
+
+        # ---- write this step's K/V and indexer keys into their caches -------------------------
+        pool.set_kv_buffer(self.attn, forward_batch.out_cache_loc,
+                           k.view(-1, KV, D), v.view(-1, KV, D),
+                           self.attn.k_scale, self.attn.v_scale)
+        self._ensure_state(kcache, fa)
+        loc = forward_batch.out_cache_loc.long()
+        ik = self.idx_norm(self.idx_k(hidden_states)[0])                       # [T, Di]
+        self.idx_cache.index_copy_(0, loc, ik.to(self.idx_cache.dtype))
+        self._write_block_keys(positions, forward_batch)
+
+        # ---- local branch: the sliding window, with its log-sum-exp ----------------------------
+        is_decode = mode.is_decode()
+        if use_fi:
+            o_loc, lse = self._local_flashinfer(fa, qh, kcache, vcache, forward_batch)
+        else:
+            o_loc, lse = self._local_fa(fa, meta, qh, kcache, vcache, is_decode)
+
+        # ---- far branch ------------------------------------------------------------------------
+        if is_decode or is_verify:
+            # Verify is decode with D queries per request, one absolute position each
+            # (positions[i*D + j] == seq_len_i + j on a chain). seq_lens_cpu is the committed
+            # length, so the last draft query sits at seq_len + D - 1.
+            nd = int(forward_batch.spec_info.draft_token_num) if is_verify else 1
+            capturing = torch.cuda.is_current_stream_capturing()
+            slc = getattr(forward_batch, "seq_lens_cpu", None)
+            if not capturing and slc is not None and int(slc.max()) + nd - 1 <= self.window:
+                # Eager decode below the window: the far set is provably empty for every request,
+                # so skip it. During capture this branch is NEVER taken (the graph is replayed at
+                # sequence lengths the capture never saw), which is why the guard is on `capturing`
+                # and not merely on the lengths.
+                return o_loc.reshape(T, H * D)
+            reqs = forward_batch.req_pool_indices.long()
+            if is_verify:
+                reqs = reqs.repeat_interleave(nd)                              # [bs * D]
+            out = self._far_sparse(hidden_states, qh, o_loc, lse, positions.long(), reqs,
+                                   kcache, vcache)
+        else:
+            out = self._far_extend(hidden_states, qh, o_loc, lse,
+                                   forward_batch, kcache, vcache)
+        return out.reshape(T, H * D).to(q.dtype)
+
+    def _local_fa(self, fa, meta, qh, kcache, vcache, is_decode):
+        """The sm90 path: one flash_attn_with_kvcache over the paged cache.
+
+        On sm90 this is the fastest option. It does NOT work on sm89: the windowed head_dim-256
+        kernel fails to launch there (flash_fwd_launch_template.h:203, invalid argument), so sm89
+        serves the window through FlashInfer instead. See _local_flashinfer.
+        """
+        T, H, D = qh.shape
+        KV = self.num_kv_heads
+        res = flash_attn_with_kvcache(
+            q=qh.contiguous(),
+            k_cache=kcache.view(-1, 1, KV, D),
+            v_cache=vcache.view(-1, 1, KV, D),
+            page_table=meta.page_table,
+            cache_seqlens=meta.cache_seqlens_int32,
+            cu_seqlens_q=meta.cu_seqlens_q,
+            cu_seqlens_k_new=None if is_decode else meta.cu_seqlens_k,
+            max_seqlen_q=meta.max_seq_len_q,
+            softmax_scale=self.scaling,
+            causal=True,
+            # (left, right) is inclusive on both sides, so W-1 back plus the query itself is the
+            # W keys of (t - W, t] that bcsa.py's loc_ok admits.
+            window_size=(self.window - 1, 0),
+            return_softmax_lse=True,
+            num_splits=getattr(fa, "num_splits", 0),
+            ver=getattr(fa, "fa_impl_ver", 3),
+        )
+        o_loc, lse = res[0].view(T, H, D), res[1]
+        # FA3 varlen returns the LSE as [heads, tokens].
+        assert lse.shape[0] == H, f"unexpected softmax_lse shape {tuple(lse.shape)}"
+        return o_loc, lse.transpose(0, 1).float().contiguous()                  # [T, H]
+
+    def _local_flashinfer(self, fa, qh, kcache, vcache, forward_batch):
+        """The Ada path: the same window through flashinfer, which IS graph-capturable at head_dim
+        256 on sm89 (measured: capture, replay, and replay-after-replan all match a reference
+        windowed softmax to bf16 tolerance).
+
+        The window is not expressed as a mask. flashinfer bakes `window_left` into the plan and
+        asserts any run-time value equals it, so borrowing the backend's own full-attention wrapper
+        is not possible; instead _BcsaFlashInfer plans a wrapper of its own whose key list is
+        already clamped to the last W tokens of each request (the trick sglang's own SWA decode
+        path uses), which is both exact and strictly less work than masking a full-length scan.
+
+        Two things about the returned LSE are easy to get wrong and silent if you do:
+          * it is in LOG2, not the natural log FA returns — the merge below is a softmax over
+            [local | far] and the local weight is exp(lse - m), so a missing ln2 mis-weights every
+            far block by a factor of e^(lse*0.44). Measured on the wrapper directly:
+            lse * ln2 / reference_logsumexp = 1.000000.
+          * it is [tokens, heads], where FA3 varlen returns [heads, tokens].
+        """
+        h = self._flashinfer_helper(fa, forward_batch)
+        w = h.current
+        if w is None:
+            raise RuntimeError(
+                f"no BCSA flashinfer plan for this forward ({forward_batch.forward_mode}); the "
+                "backend hook did not run")
+        KV, D = self.num_kv_heads, self.head_dim
+        o, lse = w.run(
+            qh.contiguous(),
+            (kcache.view(-1, 1, KV, D), vcache.view(-1, 1, KV, D)),
+            return_lse=True,
+        )
+        return o.view(qh.shape), lse.float() * _LN2
+
+    def _merge(self, sf, lse, o_loc, vb, kv_first: bool):
+        """One softmax over [local | selected far], given the local branch's LSE.
+
+        sf: [t, H, n] far scores (already -inf where a block is not selected), fp32.
+        vb: pooled far values, [n, KV, D] (shared, extend) or [t, n, KV, D] (per query, decode).
+        Returns [t, H, D] fp32.
+        """
+        t, H, n = sf.shape
+        KV, D = self.num_kv_heads, self.head_dim
+        G = H // KV
+        m = torch.maximum(lse, sf.amax(-1))                                     # [t, H]
+        w = torch.exp(lse - m)
+        pf = torch.exp(sf - m[..., None])
+        z = w + pf.sum(-1)
+        pf = (pf / z[..., None]).to(o_loc.dtype).view(t, KV, G, n)
+        if kv_first:
+            o_far = torch.einsum("tkgn,nkd->tkgd", pf, vb)
+        else:
+            o_far = torch.einsum("tkgn,tnkd->tkgd", pf, vb)
+        return (w / z)[..., None] * o_loc.float() + o_far.reshape(t, H, D).float()
+
+    def _r2t_gather(self, req_idx: torch.Tensor, cols: torch.Tensor) -> torch.Tensor:
+        """r2t[req_idx[b], cols[b, j]] without materialising whole rows: a flat gather of exactly
+        the entries asked for. req_idx [bs] int64, cols [bs, n] int64 -> [bs, n] int64."""
+        flat = self.r2t.view(-1)
+        return flat[req_idx[:, None] * self.r2t.shape[1] + cols].long()
+
+    def _write_block_keys(self, positions, forward_batch: ForwardBatch):
+        """Pool the indexer keys of every block completed by this forward into blk_cache.
+
+        Decode (graph-captured): every request pools the C slots of the block its new position
+        lies in and writes the result to its own out_cache_loc if that position closes the block
+        (pos % C == C-1), else to the trash row. Static shapes, no host sync.
+        Extend: per request, the blocks whose last position falls inside this chunk — which covers
+        chunked prefill, because a block straddling two chunks has all its positions' keys in
+        idx_cache by the time the chunk holding its last position runs.
+        """
+        C, Di = self.compress, self.idx_dim
+        hi = int(self.idx_cache.shape[0]) - 1
+        dev = self.idx_cache.device
+        if forward_batch.forward_mode.is_decode():
+            bs = positions.shape[0]
+            pos = positions.long()
+            reqs = forward_batch.req_pool_indices.long()
+            cols = (pos // C * C)[:, None] + torch.arange(C, device=dev)          # [bs, C]
+            cols.clamp_(0, self.r2t.shape[1] - 1)                                 # capture-time dummies
+            slots = self._r2t_gather(reqs, cols).clamp_(0, hi)
+            pooled = self.idx_cache[slots].view(bs, C, Di).mean(1)               # [bs, Di]
+            closes = (pos % C) == (C - 1)
+            dst = torch.where(closes, forward_batch.out_cache_loc.long(), torch.full_like(pos, hi))
+            self.blk_cache.index_copy_(0, dst, pooled.to(self.blk_cache.dtype))
+            return
+        if forward_batch.forward_mode.is_target_verify():
+            # Graph-captured: request i holds positions p0 .. p0 + D - 1 (p0 = committed
+            # length on a chain). The blocks whose last position falls in that span are the K =
+            # D // C + 1 candidates n = p0 // C + k; each is pooled from req_to_token — committed
+            # slots and this step's draft slots alike — and written at the draft slot of its
+            # last position, or at the trash row when the span does not reach it. A rejected
+            # block end is freed with its slot; an accepted one is exactly what decode would
+            # have written. Padded rows (see _live_rows) only ever write the trash row.
+            D = int(forward_batch.spec_info.draft_token_num)
+            bs = positions.shape[0] // D
+            K = D // C + 1
+            p0 = positions.view(bs, D)[:, 0].long()                               # [bs]
+            reqs = forward_batch.req_pool_indices.long()[:bs]
+            n = (p0 // C)[:, None] + torch.arange(K, device=dev)                  # [bs, K]
+            last_pos = n * C + (C - 1)
+            valid = last_pos <= (p0 + (D - 1))[:, None]
+            live = _live_rows(forward_batch, bs)
+            if live is not None:
+                valid = valid & live[:, None]
+            width = self.r2t.shape[1] - 1
+            cols = (n[:, :, None] * C + torch.arange(C, device=dev)).view(bs, K * C)
+            slots = self._r2t_gather(reqs, cols.clamp_(0, width)).clamp_(0, hi)
+            pooled = self.idx_cache[slots].view(bs, K, C, Di).mean(2)            # [bs, K, Di]
+            ends = self._r2t_gather(reqs, last_pos.clamp(0, width)).clamp_(0, hi)
+            dst = torch.where(valid, ends, torch.full_like(ends, hi)).view(-1)
+            self.blk_cache.index_copy_(0, dst, pooled.view(bs * K, Di).to(self.blk_cache.dtype))
+            return
+        seq_lens = forward_batch.seq_lens_cpu.tolist()
+        qlens = forward_batch.extend_seq_lens_cpu
+        reqs = forward_batch.req_pool_indices.long()
+        for i, ql in enumerate(qlens):
+            ql = int(ql)
+            if ql == 0:
+                continue
+            slen = int(seq_lens[i])
+            n_lo, n_hi = (slen - ql) // C, slen // C          # blocks whose last position is in this chunk
+            if n_hi <= n_lo:
+                continue
+            row = self.r2t[reqs[i]]
+            slots = row[n_lo * C: n_hi * C].long().clamp_(0, hi)
+            pooled = self.idx_cache[slots].view(n_hi - n_lo, C, Di).mean(1)
+            dst = row[n_lo * C + C - 1: n_hi * C: C].long().clamp_(0, hi)
+            self.blk_cache.index_copy_(0, dst, pooled.to(self.blk_cache.dtype))
+
+    def _far_sparse(self, hidden_states, qh, o_loc, lse, pos, reqs, kcache, vcache):
+        """One absolute position per query token, every shape static: safe to capture in a CUDA
+        graph. `pos` and `reqs` are per TOKEN ([T]); decode hands one token per request, verify
+        D tokens per request with reqs repeated. The far set of a query is read only from
+        committed blocks (last position <= pos - W), never from the draft slots of this step."""
+        C, W, NB = self.compress, self.window, self.max_blocks
+        H, KV, D = self.num_heads, self.num_kv_heads, self.head_dim
+        G = H // KV
+        bs = qh.shape[0]                                                        # tokens, really
+        dev = qh.device
+        hi = int(self.idx_cache.shape[0]) - 1                                   # trash row for pads
+        n = torch.arange(NB, device=dev)
+        # A block is far for this query iff its last position is at or before pos - W. Torch's //
+        # floors for negative numerators too, so a short sequence simply gets nmax < 0 and no block
+        # passes — the same "far set empty" the reference gets below the window.
+        nmax = (pos - W - (C - 1)).div(C, rounding_mode="floor")                # [bs]
+        valid = n[None, :] <= nmax[:, None]                                     # [bs, NB]
+
+        # pooled indexer keys of every block, one 256-byte row each, read from blk_cache at the
+        # slot of the block's last position (written when the block completed). Blocks past nmax
+        # read whatever is there (a stale or trash row) and are masked below.
+        last = self._r2t_gather(reqs, (n * C + (C - 1))[None, :].expand(bs, NB)).clamp_(0, hi)
+        kbi = self.blk_cache[last]                                              # [bs, NB, Di]
+
+        qi = self.idx_norm(self.idx_q(hidden_states)[0].reshape(-1, self.idx_dim))
+        qi = qi.view(bs, self.idx_heads, self.idx_dim)
+        s_idx = torch.einsum("bhd,bnd->bhn", qi, kbi).mean(1) * self.idx_scale
+        s_idx = s_idx.masked_fill(~valid, float("-inf"))
+        ksel = min(self.bcsa_topk, NB)
+        top = s_idx.topk(ksel, dim=-1).indices                                  # [bs, ksel]
+        sel_ok = valid.gather(1, top)
+
+        # pooled K/V of the selected blocks, straight out of the KV cache: gather the C positions of
+        # each chosen block and mean them, same pooling as the indexer keys.
+        cols = (top[:, :, None] * C + torch.arange(C, device=dev)).view(bs, ksel * C)
+        loc = self._r2t_gather(reqs, cols.clamp_(0, self.r2t.shape[1] - 1)).clamp_(0, hi)
+        kb = kcache[loc].view(bs, ksel, C, KV, D).mean(2)                       # [bs, ksel, KV, D]
+        vb = vcache[loc].view(bs, ksel, C, KV, D).mean(2)
+
+        sf = torch.einsum("bkgd,bnkd->bkgn", qh.view(bs, KV, G, D), kb) * self.scaling
+        sf = sf.reshape(bs, H, ksel).float().masked_fill(~sel_ok[:, None, :], float("-inf"))
+        return self._merge(sf, lse, o_loc, vb, kv_first=False)
+
+    def _far_extend(self, hidden_states, qh, o_loc, lse, forward_batch, kcache, vcache):
+        """Prefill / chunked prefill: one request at a time (no graphs here), chunked over queries
+        because the far scores are [tokens, 24, blocks] and that is gigabytes at 12k tokens."""
+        C, W = self.compress, self.window
+        H, KV, D = self.num_heads, self.num_kv_heads, self.head_dim
+        G = H // KV
+        dev = qh.device
+        out = o_loc.float()
+        seq_lens = forward_batch.seq_lens_cpu.tolist()
+        qlens = forward_batch.extend_seq_lens_cpu
+        r2t = self.r2t
+        reqs = forward_batch.req_pool_indices.long()
+        qi_all = self.idx_norm(self.idx_q(hidden_states)[0].reshape(-1, self.idx_dim))
+        qi_all = qi_all.view(-1, self.idx_heads, self.idx_dim)
+        hi = int(self.idx_cache.shape[0]) - 1
+        start = 0
+        for i, ql in enumerate(qlens):
+            ql = int(ql)
+            if ql == 0:
+                continue
+            slen = int(seq_lens[i])
+            # blocks that are far for at least the LAST query of this request; every earlier query
+            # sees a prefix of the same set, so this bounds the work exactly.
+            nb = (slen - 1 - W - (C - 1)) // C + 1
+            if nb <= 0:
+                start += ql
+                continue
+            tk = r2t[reqs[i], :C * nb].long().clamp_(0, hi)
+            kbi = self.blk_cache[r2t[reqs[i], C - 1: C * nb: C].long().clamp_(0, hi)]   # [nb, Di]
+            kb = kcache[tk].view(nb, C, KV, D).mean(1)                          # [nb, KV, D]
+            vb = vcache[tk].view(nb, C, KV, D).mean(1)
+            n = torch.arange(nb, device=dev)
+            ksel = min(self.bcsa_topk, nb)
+            # keep the fp32 [chunk, 24, nb] score block near 200 MB whatever nb is
+            step = max(64, min(ql, int(2.0e8) // max(1, 4 * H * nb)))
+            for a in range(0, ql, step):
+                b = min(ql, a + step)
+                sl = slice(start + a, start + b)
+                qpos = torch.arange(slen - ql + a, slen - ql + b, device=dev)
+                valid = ((n[None, :] + 1) * C - 1) <= (qpos[:, None] - W)       # [t, nb]
+                s_idx = torch.einsum("thd,nd->thn", qi_all[sl], kbi).mean(1) * self.idx_scale
+                s_idx = s_idx.masked_fill(~valid, float("-inf"))
+                top = s_idx.topk(ksel, dim=-1).indices
+                sel = torch.zeros_like(valid).scatter_(-1, top, True) & valid
+                t = b - a
+                sf = torch.einsum("tkgd,nkd->tkgn", qh[sl].view(t, KV, G, D), kb) * self.scaling
+                sf = sf.reshape(t, H, nb).float().masked_fill(~sel[:, None, :], float("-inf"))
+                out[sl] = self._merge(sf, lse[sl], o_loc[sl], vb, kv_first=True)
+            start += ql
+        return out
+
+
+def _sinkhorn(logits: torch.Tensor, iters: int) -> torch.Tensor:
+    """Doubly-stochastic projection of exp(logits) over the last two dims, in fp32."""
+    m = torch.exp(logits.float() - logits.float().amax(dim=(-1, -2), keepdim=True))
+    for _ in range(iters):
+        m = m / m.sum(-1, keepdim=True).clamp_min(1e-9)
+        m = m / m.sum(-2, keepdim=True).clamp_min(1e-9)
+    return m
+
+
+class VolundrMHC(nn.Module):
+    """Manifold hyper-connections for one layer. The residual is n streams H [tokens, n, d]:
+
+        x_in  = pre . H                                   (pre: [tokens, n])
+        H_out = res . H + post (x) (layer(x_in) - x_in)    (res doubly stochastic, post: [tokens, n])
+
+    pre / post / res are static parameters plus input-dependent deltas from `dyn` applied to the
+    normalised stream mean. Mirrors volundr_extras.MHC in the checkpoint's remote code.
+    """
+
+    def __init__(self, hidden_size: int, n: int, iters: int, eps: float, quant_config=None, prefix: str = ""):
+        super().__init__()
+        self.n, self.iters = n, iters
+        self.pre_static = nn.Parameter(torch.empty(n))
+        self.post_static = nn.Parameter(torch.empty(n))
+        self.res_static = nn.Parameter(torch.empty(n, n))
+        # torch's nn.RMSNorm in the reference (plain `weight *`), not the Gemma form the Qwen3.5
+        # layers use — mHC is Volundr's own module and was written with the stock torch layer.
+        self.norm = RMSNorm(hidden_size, eps=eps)
+        self.dyn = ReplicatedLinear(hidden_size, n + n + n * n, bias=False,
+                                    quant_config=quant_config, prefix=add_prefix("dyn", prefix))
+
+    def mix(self, H: torch.Tensor):
+        n = self.n
+        d = self.dyn(self.norm(H.mean(1)))[0].float()                      # [tokens, 2n + n*n]
+        pre = self.pre_static.float() + d[..., :n]
+        post = self.post_static.float() + d[..., n:2 * n]
+        res = _sinkhorn(self.res_static.float() + d[..., 2 * n:].view(-1, n, n), self.iters)
+        x_in = (pre.to(H.dtype).unsqueeze(-1) * H).sum(1)                  # [tokens, d]
+        return x_in, post, res
+
+    def combine(self, H: torch.Tensor, post: torch.Tensor, res: torch.Tensor, delta: torch.Tensor):
+        mixed = torch.einsum("tij,tjd->tid", res.to(H.dtype), H)
+        return mixed + post.to(H.dtype).unsqueeze(-1) * delta.unsqueeze(1)
+
+
+# hash constants shared with volundr_extras.Engram — the row index must be bit-identical.
+_ENGRAM_PRIMES = (1000003, 1000033, 1000037, 1000039, 1000081)
+_ENGRAM_MASK = 0x1FFFFFFFFFFFFFFF
+# Rows in the persistent prev-token cache. Indexed by mamba state slot; the pool here holds ~120
+# slots, so 32768 is a wide margin, and the one extra row at the end is the trash row that the
+# graph's padding sentinel (-1) wraps onto.
+_ENGRAM_PREV_ROWS = 32768
+
+
+def _engram_rows(parts, rows: int) -> torch.Tensor:
+    """Row index of the n-gram whose ids are `parts` (oldest first, int64, -1 = no token).
+
+    Mirrors volundr_extras.Engram.hash_ids exactly: ids are shifted +1 so the no-token sentinel
+    becomes 0, then folded with the rolling-prime hash and reduced mod the table size.
+    """
+    code = torch.zeros_like(parts[0])
+    for j, p in enumerate(parts):
+        code = (code * _ENGRAM_PRIMES[j % len(_ENGRAM_PRIMES)] + (p + 1)) & _ENGRAM_MASK
+    return code % rows
+
+
+class VolundrEngram(nn.Module):
+    """Hashed n-gram conditional memory (DeepSeek-Engram style), on layers 2 and 22.
+
+    For each order n in engram_orders, the trailing n token ids hash into a row of an embedding
+    table; the concatenated rows are RMS-normalised (plain torch-style norm — this is Volundr's own
+    module, not a Qwen3.5 one), projected by `value`, and gated by a sigmoid computed from the layer
+    output. Applied additively AFTER the MLP: out = out + engram(out, ids). Row indices are computed
+    once per forward in VolundrModel (both engram layers share them) because they need the
+    per-request previous-token cache.
+    """
+
+    def __init__(self, config, quant_config=None, prefix: str = ""):
+        super().__init__()
+        c = _text_cfg(config)
+        orders = list(getattr(c, "engram_orders", None) or [2, 3])
+        dim = getattr(c, "engram_dim", 512)
+        self.tables = nn.ModuleList([
+            nn.Embedding(c.engram_rows, dim) for _ in orders])
+        self.norm = RMSNorm(dim * len(orders), eps=c.rms_norm_eps)
+        self.gate = ReplicatedLinear(c.hidden_size, 1, bias=True,
+                                     quant_config=quant_config, prefix=add_prefix("gate", prefix))
+        self.value = ReplicatedLinear(dim * len(orders), c.hidden_size, bias=False,
+                                      quant_config=quant_config, prefix=add_prefix("value", prefix))
+
+    def forward(self, hidden_states: torch.Tensor, row_indices) -> Optional[torch.Tensor]:
+        if row_indices is None:
+            return None
+        e = torch.cat([t(r) for t, r in zip(self.tables, row_indices)], dim=-1)
+        e = self.norm(e)
+        g = torch.sigmoid(self.gate(hidden_states)[0].float()).to(hidden_states.dtype)
+        return g * self.value(e)[0]
+
+
+class VolundrDecoderLayer(nn.Module):
+    """Returns the layer's full output (input + mixer + MLP). sglang's usual fused add-RMSNorm
+    protocol, which threads a single residual through the stack, cannot be used: under mHC the
+    residual is n streams and the layer sees a mixed `x_in` rather than the stream itself."""
+
+    def __init__(self, config, layer_id: int, quant_config=None, prefix: str = ""):
+        super().__init__()
+        c = _text_cfg(config)
+        kind = _mixer_kind(c, layer_id)          # the tensors' own truth, via mixer_types
+        self.is_linear = kind == "kda"
+        self.layer_id = layer_id
+        if self.is_linear:
+            self.linear_attn = VolundrKDA(config, layer_id, quant_config, add_prefix("linear_attn", prefix))
+        else:
+            self.self_attn = VolundrAttention(config, layer_id, quant_config,
+                                              add_prefix("self_attn", prefix), bcsa=(kind == "bcsa"))
+        self.mlp = VolundrMLP(c.hidden_size, c.intermediate_size, quant_config, add_prefix("mlp", prefix))
+        self.input_layernorm = GemmaRMSNorm(c.hidden_size, eps=c.rms_norm_eps)
+        self.post_attention_layernorm = GemmaRMSNorm(c.hidden_size, eps=c.rms_norm_eps)
+        self.engram = (VolundrEngram(config, quant_config, add_prefix("engram", prefix))
+                       if layer_id in (getattr(c, "engram_layers", None) or []) else None)
+
+    def forward(self, positions, x, forward_batch: ForwardBatch, engram_rows=None,
+                rope_positions=None):
+        h = self.input_layernorm(x)
+        h = self.linear_attn(h, forward_batch) if self.is_linear else \
+            self.self_attn(positions, h, forward_batch, rope_positions=rope_positions)
+        h = x + h
+        h = h + self.mlp(self.post_attention_layernorm(h))
+        if self.engram is not None:
+            delta = self.engram(h, engram_rows)
+            if delta is not None:
+                h = h + delta
+        return h
+
+
+class VolundrModel(nn.Module):
+    def __init__(self, config, quant_config=None, prefix: str = ""):
+        super().__init__()
+        c = _text_cfg(config)
+        self.embed_tokens = VocabParallelEmbedding(c.vocab_size, c.hidden_size,
+                                                   prefix=add_prefix("embed_tokens", prefix))
+        self.layers = nn.ModuleList([
+            VolundrDecoderLayer(config, i, quant_config, add_prefix(f"layers.{i}", prefix))
+            for i in range(c.num_hidden_layers)])
+        self.streams = int(getattr(c, "mhc_streams", 1) or 1)
+        if self.streams > 1:
+            self.mhc = nn.ModuleList([
+                VolundrMHC(c.hidden_size, self.streams, getattr(c, "mhc_sinkhorn_iters", 10),
+                           c.rms_norm_eps, quant_config, add_prefix(f"mhc.{i}", prefix))
+                for i in range(c.num_hidden_layers)])
+        self.norm = GemmaRMSNorm(c.hidden_size, eps=c.rms_norm_eps)
+        # DFlash / EAGLE3 auxiliary hidden-state tap. sglang asks for the residual stream
+        # at the ENTRY of these layers (it maps the drafter's HF-style "after layer i" to i + 1).
+        # Under mHC the residual is n streams; the tap is stream 0, which is also what the final
+        # norm reads (hidden_states = H[:, 0]) and, with pre_static ~ e_0, what each layer mixes
+        # its input from. A drafter must be trained on exactly this quantity.
+        self.layers_to_capture: list = []
+        # Engram bookkeeping: the n-gram hash needs the 1-2 token ids BEFORE each token, which a
+        # ForwardBatch does not carry at decode time. engram_prev[slot] holds the last two token
+        # ids of each request, keyed by its mamba state slot — the one per-request index sglang
+        # already maintains as a static per-bs buffer inside the decode CUDA graph, refreshing it
+        # in place each replay with pad rows set to -1 (state_indices_list in
+        # hybrid_linear_attn_backend). The buffer here has one extra trailing row so that -1 wraps
+        # onto a trash row: pad rows read and write garbage there without touching live requests.
+        # Allocated at init, not lazily, so no allocation ever happens during graph capture.
+        self.engram_layers = list(getattr(c, "engram_layers", None) or [])
+        self.engram_rows_total = getattr(c, "engram_rows", 0)
+        self.engram_orders = list(getattr(c, "engram_orders", None) or [2, 3])
+        if self.engram_layers:
+            assert self.engram_orders == [2, 3], "engram row computation is written for orders (2, 3)"
+            self.register_buffer(
+                "engram_prev",
+                torch.full((_ENGRAM_PREV_ROWS + 1, 2), -1, dtype=torch.int32),
+                persistent=False)
+            self._engram_slot_checked = False
+            # Under speculative decoding the verify forward must not commit anything
+            # (it runs inside a CUDA graph and does not know what will be accepted), so it writes
+            # engram_cand[slot, j] = the prev pair that accepting j + 1 draft tokens leaves
+            # behind, and commit_after_verify picks the row for the accepted length.
+            self.engram_draft = _spec_draft_tokens()
+            if self.engram_draft:
+                self.register_buffer(
+                    "engram_cand",
+                    torch.full((_ENGRAM_PREV_ROWS + 1, self.engram_draft, 2), -1,
+                               dtype=torch.int32),
+                    persistent=False)
+
+    def _engram_row_indices(self, input_ids, positions, forward_batch: ForwardBatch):
+        """(rows_order2, rows_order3) for every token in the batch, plus the persistent prev-token
+        cache update. Returns None when this batch carries no tokens.
+
+        Decode: fully CUDA-graph-safe — reads input_ids and the backend's static mamba-slot buffer
+        (both refreshed in place at replay), gathers the stored prevs, and rotates the cache.
+        Extend: runs eagerly (see the capture guard); prev ids come from in-batch shifts, falling
+        back to the stored cache only for tokens whose predecessors are outside this batch (chunked
+        prefill). Serve with --disable-radix-cache: a radix prefix hit would resume a sequence whose
+        prev ids were never seeded in this cache.
+        """
+        mode = forward_batch.forward_mode
+        if mode.is_idle() or input_ids.numel() == 0:
+            return None
+        backend = get_attn_backend()
+        lin = getattr(backend, "linear_attn_backend", None)
+        meta = getattr(lin, "forward_metadata", None)
+        if meta is None or meta.mamba_cache_indices is None:
+            raise RuntimeError("Engram needs the linear-attn backend metadata (mamba slot per request)")
+        slots = meta.mamba_cache_indices.long()          # [bs]; pad rows are -1 -> trash row
+        prev = self.engram_prev
+        R = self.engram_rows_total
+
+        if mode.is_decode():
+            stored = prev[slots]                          # [B, 2]
+            p2, p1 = stored[:, 0].long(), stored[:, 1].long()
+            cur = input_ids.long()
+            rows2 = _engram_rows((p1, cur), R)
+            rows3 = _engram_rows((p2, p1, cur), R)
+            prev[slots] = torch.stack(
+                [stored[:, 1], input_ids.to(prev.dtype)], dim=-1)
+            return rows2, rows3
+
+        if mode.is_target_verify():
+            # Graph-captured: a chain of D draft ids per request. prev ids are in-batch
+            # shifts, with the committed pair (engram_prev) behind the first two, exactly the
+            # chunked-prefill rule below; nothing is committed here (see engram_cand).
+            if not getattr(self, "engram_draft", 0):
+                raise RuntimeError("Engram verify path reached without a draft-token budget")
+            D = int(forward_batch.spec_info.draft_token_num)
+            if D != self.engram_draft:
+                raise RuntimeError(
+                    f"Engram verify: draft_token_num {D} != launch-time {self.engram_draft}")
+            bs = input_ids.numel() // D
+            ids = input_ids.long().view(bs, D)
+            pos = positions.long().view(bs, D)
+            stored = prev[slots[:bs]].long()                                      # [bs, 2]
+            ext = torch.cat([stored, ids], dim=1)                                 # [bs, D + 2]
+            p1 = ext[:, 1:D + 1]
+            p2 = ext[:, 0:D]
+            p1 = torch.where(pos >= 1, p1, torch.full_like(p1, -1))
+            p2 = torch.where(pos >= 2, p2, torch.full_like(p2, -1))
+            ids_f, p1_f, p2_f = ids.reshape(-1), p1.reshape(-1), p2.reshape(-1)
+            rows2 = _engram_rows((p1_f, ids_f), R)
+            rows3 = _engram_rows((p2_f, p1_f, ids_f), R)
+            # accepting j + 1 tokens commits ids[0 .. j]: the new pair is (ids[j-1], ids[j]),
+            # i.e. (ext[j+1], ext[j+2]) — for j = 0 that is (stored p1, ids[0]).
+            cand = torch.stack([ext[:, 1:D + 1], ext[:, 2:D + 2]], dim=-1)        # [bs, D, 2]
+            self.engram_cand[slots[:bs]] = cand.to(self.engram_cand.dtype)
+            return rows2, rows3
+
+        if mode.is_extend():
+            if mode.is_draft_extend_v2():
+                raise NotImplementedError(
+                    f"Engram does not run as a draft model ({mode})")
+            if torch.cuda.is_current_stream_capturing():
+                raise RuntimeError(
+                    "the Engram extend path reads per-batch metadata that is not stable across "
+                    "prefill-graph replays; launch with --disable-prefill-cuda-graph")
+            ids = input_ids.long()
+            pos = positions.long()
+            n = ids.numel()
+            qsl = meta.query_start_loc.long()             # [bs + 1]
+            ar = torch.arange(n, device=ids.device)
+            seg = torch.searchsorted(qsl, ar, right=True) - 1     # token -> request row
+            off = ar - qsl[seg]                            # offset inside this request's segment
+            if not self._engram_slot_checked:
+                if int(slots.max()) >= _ENGRAM_PREV_ROWS:
+                    raise RuntimeError("mamba slot id exceeds the engram_prev table; enlarge _ENGRAM_PREV_ROWS")
+                from sglang.srt.runtime_context import get_server_args
+                if not get_server_args().disable_radix_cache:
+                    raise RuntimeError(
+                        "Engram serving requires --disable-radix-cache: a radix prefix hit resumes "
+                        "a sequence whose previous token ids were never seeded in engram_prev, so "
+                        "the first tokens after the cached prefix would hash garbage n-grams")
+                self._engram_slot_checked = True
+            stored_tok = prev[slots[seg]].long()           # [n, 2] this token's request cache
+            # in-batch shifts via one left-padded extension, so the lengths are right for any n
+            # (a naive cat([pad2, ids[:-2]]) is length 2, not n, when n == 1)
+            ext = torch.cat([ids.new_full((2,), -1), ids])  # [n + 2]
+            p1 = torch.where(off >= 1, ext[1:n + 1], stored_tok[:, 1])
+            p2 = torch.where(off >= 2, ext[:n],
+                             torch.where(off == 1, stored_tok[:, 1], stored_tok[:, 0]))
+            # absolute-position validity: nothing precedes the start of the sequence
+            p1 = torch.where(pos >= 1, p1, torch.full_like(p1, -1))
+            p2 = torch.where(pos >= 2, p2, torch.full_like(p2, -1))
+            rows2 = _engram_rows((p1, ids), R)
+            rows3 = _engram_rows((p2, p1, ids), R)
+            # cache each request's last two ids for the decode steps that follow. For a 1-token
+            # segment the second-last id comes from the stored cache (chunked-prefill continuation)
+            # — but only if the sequence actually has a token before this one; a brand-new request
+            # with a 1-token prompt must store the no-token sentinel, not the slot's stale content.
+            last = qsl[1:] - 1
+            seg_len = qsl[1:] - qsl[:-1]
+            old = prev[slots].long()
+            new_p2 = torch.where(
+                seg_len >= 2, ids[(last - 1).clamp(min=0)],
+                torch.where(pos[last] >= 1, old[:, 1], torch.full_like(old[:, 1], -1)))
+            prev[slots] = torch.stack(
+                [new_p2.to(prev.dtype), ids[last].to(prev.dtype)], dim=-1)
+            return rows2, rows3
+
+        raise NotImplementedError(
+            f"Engram row computation supports extend, decode and target-verify only, got {mode}")
+
+    def commit_after_verify(self, last_correct_step_indices: torch.Tensor, slots: torch.Tensor):
+        """Called once per verify step after acceptance (through the hook in
+        HybridLinearAttnBackend.update_mamba_state_after_mtp_verify) with the chain index of the
+        last accepted token per request and the requests' mamba slots: commits the prev pair the
+        verify forward staged for that accept length. Device-side only."""
+        if not self.engram_layers or not getattr(self, "engram_draft", 0):
+            return
+        s = slots.long()
+        j = last_correct_step_indices.long().clamp(0, self.engram_cand.shape[1] - 1)
+        self.engram_prev[s] = self.engram_cand[s, j]
+
+    def set_dflash_layers_to_capture(self, layers_to_capture) -> None:
+        """Entry-of-layer ids whose residual stream (stream 0) is returned as aux."""
+        ids = [int(i) for i in layers_to_capture]
+        bad = [i for i in ids if i < 0 or i >= len(self.layers)]
+        if bad:
+            raise ValueError(f"aux capture layer ids {bad} out of range [0, {len(self.layers)})")
+        self.layers_to_capture = ids
+
+    set_eagle3_layers_to_capture = set_dflash_layers_to_capture
+
+    def get_input_embeddings(self):
+        return self.embed_tokens
+
+    def forward(self, input_ids=None, positions=None, forward_batch: ForwardBatch = None,
+                inputs_embeds=None, input_embeds=None, rope_positions=None, token_ids=None, **kw):
+        """Two calling conventions: the text class calls (input_ids, positions, forward_batch);
+        general_mm_embed_routine calls (input_ids=None, forward_batch=, input_embeds=, **kwargs) with
+        `positions`, `rope_positions` and `token_ids` in kwargs — token_ids being the real ids (image
+        spans set to image_token_id) that Engram hashes, since the routine's input_ids are None."""
+        if inputs_embeds is None:
+            inputs_embeds = input_embeds
+        if input_ids is None:
+            input_ids = token_ids
+        if positions is None:
+            positions = forward_batch.positions
+        hidden_states = self.embed_tokens(input_ids) if inputs_embeds is None else inputs_embeds
+
+        engram_rows = (self._engram_row_indices(input_ids, positions, forward_batch)
+                       if self.engram_layers else None)
+
+        cap = self.layers_to_capture
+        aux = []
+        if self.streams > 1:
+            H = hidden_states.unsqueeze(1).expand(-1, self.streams, -1).contiguous()
+            for i, layer in enumerate(self.layers):
+                if cap and i in cap:
+                    aux.append(H[:, 0, :])                 # residual stream 0 at layer entry
+                x_in, post, res = self.mhc[i].mix(H)
+                y = layer(positions, x_in, forward_batch, engram_rows=engram_rows,
+                          rope_positions=rope_positions)
+                H = self.mhc[i].combine(H, post, res, y - x_in)
+            hidden_states = H[:, 0, :]
+        else:
+            for i, layer in enumerate(self.layers):
+                if cap and i in cap:
+                    aux.append(hidden_states)
+                hidden_states = layer(positions, hidden_states, forward_batch,
+                                      engram_rows=engram_rows, rope_positions=rope_positions)
+
+        hidden_states = self.norm(hidden_states)
+        if aux:
+            return hidden_states, aux
+        return hidden_states
+
+
+class _VolundrLM(nn.Module):
+    """The language model + head; vision tensors are dropped at load time here. The two public
+    classes below select the text-only model (VolundrForCausalLM) or the vision-serving one
+    (VolundrForConditionalGeneration)."""
+
+    # Tensors that are deliberately not loaded, and why. Anything else the checkpoint carries that
+    # this class has no parameter for is a bug, and load_weights raises rather than serving a model
+    # with a silently missing tower.
+    _IGNORED = (".visual.", "visual.")
+
+    def __init__(self, config, quant_config: Optional[QuantizationConfig] = None, prefix: str = ""):
+        super().__init__()
+        self.config = config
+        c = _text_cfg(config)
+        self.quant_config = quant_config
+        self._check_spec_args(c)
+        self.model = VolundrModel(config, quant_config, add_prefix("model.language_model", prefix))
+        self.lm_head = ParallelLMHead(c.vocab_size, c.hidden_size, quant_config=quant_config,
+                                      prefix=add_prefix("lm_head", prefix))
+        self.logits_processor = LogitsProcessor(c)
+        # set by sglang's DFlash / EAGLE3 workers through set_*_layers_to_capture
+        self.capture_aux_hidden_states = False
+
+    def set_dflash_layers_to_capture(self, layer_ids) -> None:
+        """DFlash hands HF-style 'after layer i' ids; sglang's convention captures the
+        residual stream at the entry of layer i + 1 (qwen3_next does the same +1)."""
+        if layer_ids is None:
+            raise ValueError("DFLASH requires explicit layer_ids for aux hidden capture.")
+        self.capture_aux_hidden_states = True
+        self.model.set_dflash_layers_to_capture([int(v) + 1 for v in layer_ids])
+
+    def set_eagle3_layers_to_capture(self, layer_ids=None) -> None:
+        n = len(self.model.layers)
+        ids = [2, n // 2, n - 3] if layer_ids is None else [int(v) + 1 for v in layer_ids]
+        self.capture_aux_hidden_states = True
+        self.model.set_dflash_layers_to_capture(ids)
+
+    @staticmethod
+    def _check_spec_args(c) -> None:
+        """Speculative decoding is served as a chain only (see the module docstring)."""
+        try:
+            sa = get_server_args()
+        except Exception:
+            return
+        if sa is None or not getattr(sa, "speculative_algorithm", None):
+            return
+        topk = int(getattr(sa, "speculative_eagle_topk", None) or 1)
+        if topk > 1:
+            raise ValueError(
+                f"Volundr serves speculative decoding as a CHAIN only (topk 1); got "
+                f"speculative_eagle_topk={topk}. For NGRAM pass --speculative-ngram-max-bfs-"
+                "breadth 1 (sglang sets topk from it); for EAGLE pass --speculative-eagle-topk 1.")
+        nd = int(getattr(sa, "speculative_num_draft_tokens", None) or 0)
+        window = int(getattr(c, "bcsa_window", 4096) or 4096)
+        if nd < 1 or nd > window:
+            raise ValueError(
+                f"--speculative-num-draft-tokens must be in [1, bcsa_window={window}], got {nd}")
+        if getattr(sa, "attention_backend", None) not in (None, "flashinfer"):
+            raise ValueError(
+                "Volundr speculative decoding needs --attention-backend flashinfer (the BCSA local "
+                f"branch has a verify plan there only); got {sa.attention_backend!r}")
+
+    def commit_after_verify(self, last_correct_step_indices: torch.Tensor, slots: torch.Tensor):
+        """Post-verify commit hook (see VolundrModel.commit_after_verify)."""
+        self.model.commit_after_verify(last_correct_step_indices, slots)
+
+    def get_input_embeddings(self):
+        return self.model.embed_tokens
+
+    @torch.no_grad()
+    def forward(self, input_ids, positions, forward_batch: ForwardBatch, inputs_embeds=None, **kw):
+        hidden_states = self.model(input_ids, positions, forward_batch, inputs_embeds)
+        aux_hidden_states = None
+        if self.capture_aux_hidden_states:
+            hidden_states, aux_hidden_states = hidden_states
+        return _mask_unused_tokens(self.logits_processor(
+            input_ids, hidden_states, self.lm_head, forward_batch, aux_hidden_states))
+
+    def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]):
+        stacked = [("gate_up_proj", "gate_proj", 0), ("gate_up_proj", "up_proj", 1)]
+        params = dict(self.named_parameters())
+        filled, skipped = set(), 0
+        for name, w in weights:
+            if any(tok in name for tok in self._IGNORED):
+                skipped += 1
+                continue
+            n = name.replace("model.language_model.", "model.").replace("language_model.", "model.")
+            if n.startswith("model.model."):
+                n = n[len("model."):]
+            done = False
+            for target, src, shard in stacked:
+                if src in n:
+                    tn = n.replace(src, target)
+                    p = params.get(tn)
+                    if p is None:
+                        break
+                    p.weight_loader(p, w, shard)
+                    filled.add(tn)
+                    done = True
+                    break
+            if done:
+                continue
+            p = params.get(n)
+            if p is None:
+                raise ValueError(
+                    f"checkpoint tensor {name!r} has no parameter in the Volundr text model "
+                    f"(mapped to {n!r}); add it to the class or to _IGNORED with a reason")
+            getattr(p, "weight_loader", default_weight_loader)(p, w)
+            filled.add(n)
+        # vision parameters (only present on VolundrForConditionalGeneration) are loaded and
+        # verified by that class before it hands the text tensors here
+        missing = sorted(n for n in set(params) - filled if not n.startswith("visual."))
+        if missing:
+            raise ValueError(
+                f"{len(missing)} parameters were never loaded, e.g. {missing[:8]} — "
+                "the checkpoint and this class disagree")
+        return {"loaded": len(filled), "skipped": skipped}
+
+
+class VolundrForCausalLM(_VolundrLM):
+    """Text-only class (architectures: ["VolundrForCausalLM"]): the language model without the
+    vision tower."""
+
+
+class VolundrForConditionalGeneration(_VolundrLM):
+    """The full checkpoint: vision tower + merger in front of the Volundr language model. Serve with --enable-multimodal; sglang's QwenVLImageProcessor (patched to list this
+    class) turns `image_url` parts into <|vision_start|><|image_pad|>...<|vision_end|> spans, exactly
+    the tokens the Agens chat template emits and the HF path (modeling_volundr.py) consumes.
+
+    Positions: the model is MRoPE (mrope_section [11, 11, 10] over the 64 rotary dims). An extend
+    batch that carries images feeds forward_batch.mrope_positions [3, N] to the BCSA layers' rotary;
+    every other batch (text-only extends, all decodes — after an image the three rows coincide) uses
+    the t-row through the plain rotary kernel, so text-only requests are bit-identical to
+    VolundrForCausalLM. KV slots, BCSA block boundaries and Engram's prev-token cache are indexed by
+    the 1-D token position, never by mrope values.
+
+    Engram ids: sglang overwrites image-token ids with per-image hash values (that is how it finds
+    the spans to embed). For the n-gram hash those positions are restored to image_token_id, which
+    is what the HF path sees, so the Engram contribution on image tokens matches it.
+    Deepstack: Volundr's vision config has no deepstack layers (deepstack_visual_indexes = []).
+    """
+
+    def __init__(self, config, quant_config: Optional[QuantizationConfig] = None, prefix: str = ""):
+        super().__init__(config, quant_config, prefix)
+        self.pp_group = get_pp_group()
+        vc = getattr(config, "vision_config", None)
+        if vc is None:
+            raise ValueError("VolundrForConditionalGeneration needs config.vision_config; serve the "
+                             "text-only view (VolundrForCausalLM) if the vision tower is not wanted")
+        if getattr(vc, "deepstack_visual_indexes", None):
+            raise NotImplementedError("Volundr's vision config is expected to have no deepstack layers")
+        from sglang.srt.models.qwen3_vl import Qwen3VLMoeVisionModel
+        c = _text_cfg(config)
+        self.use_data_parallel = bool(getattr(get_server_args(), "mm_enable_dp_encoder", False))
+        if self.use_data_parallel:
+            raise NotImplementedError("--mm-enable-dp-encoder is not wired for Volundr")
+        self.visual = Qwen3VLMoeVisionModel(
+            vc, quant_config=None, norm_eps=getattr(c, "rms_norm_eps", 1e-6),
+            prefix=add_prefix("model.visual", prefix), use_data_parallel=False)
+        rp = dict(getattr(c, "rope_parameters", None) or getattr(c, "rope_scaling", None) or {})
+        self.is_mrope_enabled = "mrope_section" in rp
+        self.deepstack_visual_indexes = []
+        self.use_deepstack = {}
+        self.image_token_id = int(getattr(config, "image_token_id", 248056))
+        self.video_token_id = int(getattr(config, "video_token_id", 248057))
+
+    # ---- hooks sglang's multimodal machinery calls
+    def pad_input_ids(self, input_ids, mm_inputs: MultimodalInputs):
+        return MultiModalityDataPaddingPatternMultimodalTokens().pad_input_tokens(input_ids, mm_inputs)
+
+    def get_image_feature(self, items: list) -> torch.Tensor:
+        pixel_values = torch.cat([item.feature for item in items], dim=0).type(self.visual.dtype)
+        grid = torch.cat([item.image_grid_thw for item in items], dim=0)
+        assert pixel_values.dim() == 2 and grid.dim() == 2, (pixel_values.shape, grid.shape)
+        return self.visual(pixel_values, grid_thw=grid)
+
+    def get_video_feature(self, items: list) -> torch.Tensor:
+        pixel_values = torch.cat([item.feature for item in items], dim=0).type(self.visual.dtype)
+        grid = torch.cat([item.video_grid_thw for item in items], dim=0)
+        return self.visual(pixel_values, grid_thw=grid)
+
+    def _engram_token_ids(self, input_ids: torch.Tensor, forward_batch: ForwardBatch) -> torch.Tensor:
+        """input_ids with every multimodal span set back to its placeholder token id."""
+        if forward_batch.forward_mode.is_decode() or not forward_batch.contains_mm_inputs():
+            return input_ids
+        pads_img, pads_vid = [], []
+        for mm in forward_batch.mm_inputs or []:
+            for it in (getattr(mm, "mm_items", None) or []):
+                (pads_vid if it.modality == Modality.VIDEO else pads_img).append(int(it.pad_value))
+        ids = input_ids.clone()
+        for pads, tok in ((pads_img, self.image_token_id), (pads_vid, self.video_token_id)):
+            if pads:
+                m = torch.isin(ids, torch.tensor(pads, device=ids.device, dtype=ids.dtype))
+                ids = torch.where(m, torch.full_like(ids, tok), ids)
+        return ids
+
+    @torch.no_grad()
+    def forward(self, input_ids, positions, forward_batch: ForwardBatch, inputs_embeds=None,
+                get_embedding: bool = False, **kw):
+        if self.capture_aux_hidden_states:
+            # Speculative decoding (DFlash / EAGLE3) taps the language model's residual stream.
+            # Text batches take the text path, which is exactly VolundrForCausalLM (for text the
+            # three MRoPE rows equal the 1-D positions); image inputs together with a drafter are
+            # not supported.
+            if forward_batch.contains_mm_inputs():
+                raise NotImplementedError(
+                    "speculative decoding is supported for text requests only; serve without "
+                    "--enable-multimodal (or without a drafter) to send images")
+            return _VolundrLM.forward(self, input_ids, positions, forward_batch, inputs_embeds)
+        rope_positions = None
+        if self.is_mrope_enabled:
+            mp = forward_batch.mrope_positions
+            if mp is not None and mp.ndim == 2:
+                if forward_batch.forward_mode.is_extend() and forward_batch.contains_image_inputs():
+                    rope_positions = mp                     # [3, N]: the BCSA layers take the MRoPE path
+                else:
+                    positions = mp[0]                      # rows coincide: plain rotary on the t-row
+        token_ids = self._engram_token_ids(input_ids, forward_batch)
+        hidden_states = general_mm_embed_routine(
+            input_ids=input_ids, forward_batch=forward_batch, language_model=self.model,
+            multimodal_model=self, positions=positions, rope_positions=rope_positions,
+            token_ids=token_ids, use_deepstack=self.use_deepstack)
+        return _mask_unused_tokens(
+            self.logits_processor(input_ids, hidden_states, self.lm_head, forward_batch))
+
+    def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]):
+        """Vision tensors go to self.visual (sglang's VisionAttention names the fused projection
+        qkv_proj); everything else through the text loader, which then verifies completeness."""
+        params = dict(self.named_parameters())
+        text, filled = [], set()
+        for name, w in weights:
+            if ".visual." in name or name.startswith("visual."):
+                n = name.replace("model.visual.", "visual.").replace("attn.qkv.", "attn.qkv_proj.")
+                p = params.get(n)
+                if p is None:
+                    raise ValueError(f"vision tensor {name!r} has no parameter (mapped to {n!r})")
+                getattr(p, "weight_loader", default_weight_loader)(p, w)
+                filled.add(n)
+                continue
+            text.append((name, w))
+        vis_missing = sorted(n for n in params if n.startswith("visual.") and n not in filled)
+        if vis_missing:
+            raise ValueError(f"{len(vis_missing)} vision parameters never loaded, e.g. {vis_missing[:6]}")
+        out = _VolundrLM.load_weights(self, text)
+        out["visual"] = len(filled)
+        return out
+
+
+EntryClass = [VolundrForConditionalGeneration, VolundrForCausalLM]

@@ -0,0 +1,29 @@
+"""Agens tool-call detector for SGLang (`--tool-call-parser agens`).
+
+Agens models emit tool calls as
+    <|call|>\n<function=NAME>\n<parameter=ARG>\nVALUE\n</parameter>\n</function>\n<|/call|>
+This is sglang's Qwen3-Coder detector with the Agens sentinels; calls come out as OpenAI-style
+`tool_calls`.
+"""
+import re
+
+from sglang.srt.function_call.core_types import StructureInfo, _GetInfoFunc
+from sglang.srt.function_call.qwen3_coder_detector import Qwen3CoderDetector
+
+
+class AgensDetector(Qwen3CoderDetector):
+    def __init__(self):
+        super().__init__()
+        self.tool_call_start_token = "<|call|>"
+        self.tool_call_end_token = "<|/call|>"
+        self.tool_call_regex = re.compile(r"<\|call\|>(.*?)<\|/call\|>", re.DOTALL)
+
+    def structure_info(self) -> _GetInfoFunc:
+        return lambda name: StructureInfo(
+            begin="<|call|>\n<function=" + name + ">\n",
+            end="</function>\n<|/call|>",
+            trigger="<|call|>",
+        )
+
+    def get_structural_tag_name(self) -> str:
+        return "agens_b"
